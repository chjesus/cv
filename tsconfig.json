{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@*": [
        "src/*"
      ],
      "@app/*": [
        "app/*"
      ],
      "@pages/*": [
        "pages/*"
      ],
      "@shared/*": [
        "shared/*"
      ],
      "@widgets/*": [
        "widgets/*"
      ],
      "@entities/*": [
        "entities/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}