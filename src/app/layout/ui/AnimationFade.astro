---
interface Props {
  translateX?: number
  translateY?: number
  delay?: number
  class?: string
}

const {
  translateX = 0,
  translateY = 0,
  delay = 0.3,
  class: className,
} = Astro.props
---

<div
  class:list={['animation-fade', className]}
  style={`--fade-x: ${translateX}px; --fade-y: ${translateY}px; --fade-delay: ${delay}s;`}
>
  <slot />
</div>

<style>
  .animation-fade {
    opacity: 0;
    transform: translate(var(--fade-x, 0px), var(--fade-y, 0px));
    transition:
      opacity 0.8s cubic-bezier(0.39, 0.575, 0.565, 1),
      transform 0.8s cubic-bezier(0.39, 0.575, 0.565, 1);
    transition-delay: var(--fade-delay, 0.3s);
  }

  .animation-fade.is-visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .animation-fade {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible')
          observer.unobserve(entry.target)
        }
      })
    },
    { threshold: 0.2 },
  )

  document.querySelectorAll('.animation-fade').forEach((el) => {
    observer.observe(el)
  })
</script>
