---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'

import Container from '@app/layout/ui/Container.astro'

import { PUBLIC_URL_BUCKET } from '@shared/constants/env'
---

<nav class="nav fixed w-full">
	<Container>
		<div class="nav-container md:gap-x-18 px-12 py-4 md:px-4 lg:gap-x-36">
			<div class="hidden gap-x-2 md:grid md:grid-cols-3">
				<a class="nav-item rounded-full" href="#home">Home</a>
				<a class="nav-item rounded-full" href="#about">About</a>
				<a class="nav-item rounded-full" href="#experience">Experience</a>
			</div>
			<div class="text-center md:m-auto">
				<a href="/">
					<figure class="lg:cursor-pointer">
						<Image
							class="w-[84px] object-cover md:w-[125px] lg:w-[145px] xl:w-[200px]"
							src={`${PUBLIC_URL_BUCKET}/img/logo.png`}
							alt="Logo Jesus DEV"
              inferSize={true}
						/>
					</figure>
				</a>
			</div>
		<div class="ml-auto md:hidden">
			<button
				type="button"
				class="cursor-pointer border-none bg-transparent p-0"
				aria-label="Abrir menú de navegación"
				id="menu-open-btn"
			>
				<Icon
					class="text-5xl text-black"
					name="heroicons:bars-3-center-left-16-solid"
				/>
			</button>
		</div>
			<div class="hidden gap-x-2 md:grid md:grid-cols-3">
				<a class="nav-item rounded-full" href="#services">Services</a>
				<a class="nav-item rounded-full" href="#portfolio">My projects</a>
				<a class="nav-item rounded-full" href="#contact">Contact us</a>
			</div>
		</div>
	</Container>
</nav>

<style lang="scss">
	@use './scss/Nav.scss';
</style>
