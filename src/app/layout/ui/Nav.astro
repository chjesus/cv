---
import { Icon } from 'astro-icon/components'
import LOGOHEADER from '@shared/assets/img/logo_white.svg'
import LOGOHEADERMOBILE from '@shared/assets/img/logo_mobile.svg'
import Container from '@app/layout/ui/Container.astro'

const navItems = [
  { label: 'Inicio', href: '#home' },
  { label: 'Sobre mí', href: '#about' },
  { label: 'Experiencia', href: '#experience' },
  { label: 'Servicios', href: '#services' },
  { label: 'Portafolio', href: '#portfolio' },
  { label: 'Contacto', href: '#contact' },
]

const mobileNavItems = [
  { label: 'Inicio', href: '#home' },
  { label: 'Sobre mí', href: '#about' },
  { label: 'Servicios', href: '#services' },
  { label: 'Portafolio', href: '#portfolio' },
  { label: 'Contacto', href: '#contact' },
  { label: 'Contrátame', href: '#contact' },
]
---

<nav class="nav fixed top-0 z-50 w-full" id="site-nav">
  <Container class="!max-w-[1280px]">
    <div class="nav-container">
      <a class="nav-logo nav-logo--desktop" href="/" aria-label="Ir al inicio">
        <LOGOHEADER />
      </a>
      <a class="nav-logo nav-logo--mobile" href="/" aria-label="Ir al inicio">
        <LOGOHEADERMOBILE />
      </a>

      <div class="nav-links" aria-label="Navegación principal">
        {navItems.map((item, index) => (
          <a
            class:list={['nav-item', { 'is-active': index === 0 }]}
            href={item.href}
          >
            {item.label}
          </a>
        ))}
      </div>

      <button
        type="button"
        class="nav-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="menu-open-btn"
      >
        <Icon
          class="text-[2.15rem]"
          name="heroicons:bars-3-center-left-16-solid"
        />
      </button>
    </div>
  </Container>

  <div
    class="mobile-menu"
    id="mobile-menu"
    data-open="false"
    aria-hidden="true"
  >
    <div class="mobile-menu__backdrop" data-mobile-menu-close></div>
    <div
      class="mobile-menu__panel"
      role="dialog"
      aria-modal="true"
      aria-label="Navegación móvil"
    >
      <div class="mobile-menu__header">
        <button
          type="button"
          class="mobile-menu__close"
          aria-label="Cerrar menú de navegación"
          id="menu-close-btn"
        >
          <Icon class="text-[2rem]" name="heroicons:x-mark-16-solid" />
        </button>
      </div>

      <div class="mobile-menu__links" aria-label="Enlaces de navegación móvil">
        {mobileNavItems.map((item) => (
          <a class="mobile-menu__item" href={item.href}>
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('site-nav')
  const button = document.getElementById('menu-open-btn')
  const closeButton = document.getElementById('menu-close-btn')
  const menu = document.getElementById('mobile-menu')
  const closeTargets = menu?.querySelectorAll('[data-mobile-menu-close]')
  const desktopLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.nav-links .nav-item'),
  )

  const setMenuOpen = (isOpen: boolean) => {
    menu?.setAttribute('data-open', String(isOpen))
    menu?.setAttribute('aria-hidden', String(!isOpen))
    button?.setAttribute('aria-expanded', String(isOpen))
    button?.setAttribute(
      'aria-label',
      isOpen ? 'Cerrar menú de navegación' : 'Abrir menú de navegación',
    )
  }

  const syncNav = () => {
    nav?.classList.toggle('is-scrolled', window.scrollY > 50)
  }

  const setActiveDesktopLink = (href: string) => {
    desktopLinks.forEach((link) => {
      link.classList.toggle('is-active', link.getAttribute('href') === href)
    })
  }

  button?.addEventListener('click', () => {
    const isOpen = menu?.getAttribute('data-open') === 'true'
    setMenuOpen(!isOpen)
  })

  closeButton?.addEventListener('click', () => setMenuOpen(false))
  closeTargets?.forEach((target) => {
    target.addEventListener('click', () => setMenuOpen(false))
  })

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false))
  })

  desktopLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href')

      if (href) {
        setActiveDesktopLink(href)
      }
    })
  })

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuOpen(false)
    }
  })

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      setMenuOpen(false)
    }
  })

  syncNav()
  window.addEventListener('scroll', syncNav, { passive: true })
</script>

<style lang="scss">
  @use './scss/Nav.scss';
</style>
