---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'

import Logo from '@shared/assets/logo.png'
import Container from '@app/layout/ui/Container.astro'
---

<nav class="nav fixed w-full">
	<Container>
		<div class="nav-container md:gap-x-18 px-12 py-4 md:px-4 lg:gap-x-36">
			<div class="hidden gap-x-2 md:grid md:grid-cols-3">
				<div class="nav-item rounded-full">Home</div>
				<div class="nav-item rounded-full">About</div>
				<div class="nav-item rounded-full">Services</div>
			</div>
			<div class="text-center md:m-auto">
				<figure class="lg:cursor-pointer">
					<Image
						class="w-[84px] object-cover md:w-[125px] lg:w-[145px] xl:w-[200px]"
						src={Logo}
						alt="Logo Jesus DEV"
					/>
				</figure>
			</div>
			<div class="ml-auto md:hidden">
				<Icon class="text-5xl" name="heroicons:bars-3-center-left-16-solid" />
			</div>
			<div class="hidden gap-x-2 md:grid md:grid-cols-3">
				<div class="nav-item rounded-full">Portfolio</div>
				<div class="nav-item rounded-full">My projects</div>
				<div class="nav-item rounded-full">Contact us</div>
			</div>
		</div>
	</Container>
</nav>

<style lang="scss">
	@import './scss/Nav.scss';
</style>
