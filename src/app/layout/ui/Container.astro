---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
	isFooter?: boolean
}

const { class: className, isFooter = false } = Astro.props
---

<div
	class:list={[
		'mx-auto',
		'max-w-[1240px]',
		'px-[3rem]',
		{ 'px-[5.2rem]': isFooter },
		'md:px-28',
		'xl:px-0',
		className,
	]}
>
	<slot />
</div>
