---
import '@shared/assets/scss/variables.scss'
import '@shared/assets/scss/global.scss'
import '@shared/assets/scss/lib.css'

interface Props {
	title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="keywords"
			content="Jesús Chacón, Frontend Developer, Ingeniero en Informática, Desarrollo Frontend, JavaScript, React, Astro JS, Next.js, Tailwind CSS, TypeScript, Vercel, Git, SEO, Google Analytics, diseño UX/UI, soluciones web personalizadas, creación de experiencias web, optimización web, Desarrollador Web, Experiencia de Usuario, Código Limpio"
		/>
		<meta
			name="description"
			content="Soy Jesús Chacón, Ingeniero en Informática y Desarrollador Front-end. Apasionado por crear experiencias de usuario excepcionales y código limpio."
		/>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global></style>
