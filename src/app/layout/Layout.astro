---
interface Props {
	title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap');
	@import url('https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap');
	@import url('https://fonts.googleapis.com/css2?family=Cardo:ital,wght@0,400;0,700;1,400&display=swap');
	:root {
		--primary: #5104a3;
		--primary-dark: #1e013d;
		--secondary: #d8d8d8;
		--secondary-dark: #37474f;
		--background: #110123;
		--background-dark: #000000;
		--text: #ffffff;
		--text-dark: #000000;
		--text-card-service: #718096;
		--text-card-service-secondary: #2d3748;
		--text-card-portfolio: #454d55;
		--text-card-portfolio-secondary: #000000;
		--text-card-testimonial: #f9fafb;
		--text-card-testimonial-secondary: #fcfcfd;
		--accent-light: var(--primary);
		--accent-dark: var(--primary-dark);
		--accent-gradient: linear-gradient(
			0deg,
			var(--accent-light) 0%,
			var(--accent-light) 100%
		);
		--accent-card: #e7f3f2;
		--accent-card-light: #ebf4f8;
		--accent-card-dark: #dfeef9;
		--accent-card-gradient: linear-gradient(
			0deg,
			var(--accent-card) 0%,
			var(--accent-card-light) 51%,
			var(--accent-card-dark) 100%
		);
		/* font-family: 'Source Sans 3'; */
		/* font-style: normal; */
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-size: 49.11%;
	}

	body {
		width: 100%;
		min-height: 100vh;
	}

	@media (min-width: 576px) {
		html {
		}
	}
	@media (min-width: 768px) {
		html {
		}
	}
	@media (min-width: 992px) {
		html {
      font-size: 43.75%;
		}
	}
	@media (min-width: 1200px) {
		html {
			font-size: 62.5%;
		}
	}
</style>
