---
import { Icon } from 'astro-icon/components'
import AnimationFade from '@app/layout/ui/AnimationFade'

type Props = {
	date: string
	title: string
	subtitle: string
	description: string
	delay?: number
	type: 'even' | 'odd'
}

const { date, title, subtitle, description, delay, type } = Astro.props
---

<AnimationFade tranlasteY={50} delay={delay} client:visible>
	<article class=`card_project ${type}`>
		<figure class="card_project-image">
			<img
				class="size-full object-cover"
				src="https://media.istockphoto.com/id/1226444511/es/vector/ilustraci%C3%B3n-conceptual-de-la-tecnolog%C3%ADa-de-desarrollo-de-sitios-web-m%C3%B3viles-dise%C3%B1o-de.jpg?s=2048x2048&w=is&k=20&c=u2c0gjtgdfQzUY9FaWe_5SWYYOZXLBwntiFvumVl9u4="
				alt=""
			/>
		</figure>
		<div class="flex flex-col gap-3 p-4 md:gap-5 md:p-6">
			<div class="card_project-info flex">
				<span class="card_project-info_date">{date}</span>
				<div class="flex gap-2">
					<Icon name="catppuccin:html" class="text-5xl" />
					<Icon name="catppuccin:css3" class="text-5xl" />
					<Icon name="catppuccin:javascript" class="text-5xl" />
				</div>
			</div>
			<div>
				<h2 class="card_project-title">{title}</h2>
				<h3 class="card_project-subtitle">{subtitle}</h3>
			</div>
			<p class="card_project-description">{description}</p>
		</div>
	</article>
</AnimationFade>

<style lang="scss">
	.card_project {
		background: #e7f3f2;
		border-radius: 1.3rem;
		overflow: hidden;
		&.even {
			background: var(--even-card-gradient);
		}
		&.odd {
			background: var(--odd-card-gradient);
		}
		@media (min-width: 768px) {
			border-radius: 2.2rem;
		}
		&-image {
			height: 120px;
			@media (min-width: 768px) {
				height: 200px;
			}
			@media (min-width: 1280px) {
				height: 292px;
			}
		}
		&-title {
			font-size: 2.4rem;
			font-family: 'Roboto';
			line-height: initial;
			font-weight: 600;
			margin-bottom: 2px;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			color: var(--text-card-portfolio-primary);
		}
		&-subtitle {
			font-size: 1.4rem;
			font-family: 'Roboto';
			font-weight: 400;
			color: var(--text-card-portfolio-primary);
		}
		&-description {
			font-size: 1.6rem;
			font-family: 'Cardo';
			line-height: normal;
			font-weight: 400;
			color: var(--text-card-portfolio-secondary);
		}
		&-info {
			justify-content: space-between;
			align-items: center;
			&_date {
				font-size: 1.4rem;
				font-family: 'Cardo';
				line-height: normal;
				font-weight: 400;
				color: var(--text-card-portfolio-secondary);
			}
		}
	}
</style>
