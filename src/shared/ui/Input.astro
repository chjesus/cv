---
type Props = {
	className?: string
	placeholder?: string
	type: 'text' | 'email' | 'password' | 'number'
}

const { className = '', type, placeholder = '' } = Astro.props
---

<input type={type} class={className} placeholder={placeholder} />

<style>
	input {
		padding: 1.7rem 2rem;
		border: 1px solid var(--white);
		background-color: transparent;
		border-radius: 3.4rem;
		width: 100%;
		font-size: 1.4rem;
		outline: none;
		color: var(--text-white);
		&::placeholder {
			color: var(--text-white);
			font-size: 1.4rem;
		}
	}
</style>
