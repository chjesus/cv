---
const { class: className } = Astro.props
---

<h2 class:list={[className]}>
	<slot />
</h2>

<style lang="scss">
	h2 {
    line-height: normal;
    font-size: 3.5rem;
		font-weight: 900;
		font-family: 'Roboto';
		color: var(--text);
    @media (min-width: 768px) {
      font-size: 4rem;
    }
    @media (min-width: 998px) {
      font-size: 4.6rem;
    }
	}
</style>
