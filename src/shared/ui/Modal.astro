---
import { Icon } from 'astro-icon/components'
---

<dialog id="menu" class="modal items-start" aria-label="Menú de navegación">
	<div class="modal-box p-18 relative mt-24 w-9/12 max-w-5xl bg-white">
		<form method="dialog" class="absolute right-6 top-6">
			<button class="outline-none" aria-label="Cerrar menú">
				<Icon name="mdi:close" class="text-6xl text-black" />
			</button>
		</form>
		<nav class="menu flex" aria-label="Navegación móvil">
			<li class="menu-item">
				<a class="menu-link p-0" href="#home">Home</a>
			</li>
			<li class="menu-item">
				<a class="menu-link p-0" href="#about">About</a>
			</li>
			<li class="menu-item">
				<a class="menu-link p-0" href="#experience">Experience</a>
			</li>
			<li class="menu-item">
				<a class="menu-link p-0" href="#services">Services</a>
			</li>
			<li class="menu-item">
				<a class="menu-link p-0" href="#portfolio">My Projects</a>
			</li>
			<li class="menu-item">
				<a class="menu-link p-0" href="#contact">Contact us</a>
			</li>
		</nav>
	</div>
	<form method="dialog" class="modal-backdrop">
		<button class="outline-none">close</button>
	</form>
</dialog>

<script>
	const menuDialog = document.getElementById('menu') as HTMLDialogElement | null
	const menuOpenBtn = document.getElementById('menu-open-btn')
	const menuLinks = document.querySelectorAll('.menu-link')

	menuOpenBtn?.addEventListener('click', () => {
		menuDialog?.showModal()
	})

	menuLinks.forEach((link) => {
		link.addEventListener('click', () => {
			menuDialog?.close()
		})
	})

	menuDialog?.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			menuDialog.close()
		}
	})
</script>

<style lang="scss">
	@use './scss/Modal.scss';
</style>
