---
import { Icon } from 'astro-icon/components'
---

<dialog id="menu" class="modal items-start">
	<div class="modal-box p-18 relative mt-24 w-9/12 max-w-5xl bg-white">
		<form method="dialog" class="absolute right-6 top-6">
			<button class="outline-none">
				<Icon name="mdi:close" class="text-6xl text-black" />
			</button>
		</form>
		<div class="menu flex">
			<li class="menu-item">
				<a class="p-0" href="#home" onclick="menu.close()">Home</a>
			</li>
			<li class="menu-item">
				<a class="p-0" href="#about" onclick="menu.close()">About</a>
			</li>
			<li class="menu-item">
				<a class="p-0" href="#experience" onclick="menu.close()">Experience</a>
			</li>
			<li class="menu-item">
				<a class="p-0" href="#services" onclick="menu.close()">Services</a>
			</li>
			<li class="menu-item">
				<a class="p-0" href="#portfolio" onclick="menu.close()">My Projects</a>
			</li>
			<li class="menu-item">
				<a class="p-0" href="#contact" onclick="menu.close()">Contact us</a>
			</li>
		</div>
	</div>
	<form method="dialog" class="modal-backdrop">
		<button class="outline-none">close</button>
	</form>
</dialog>

<style lang="scss">
	.menu {
		width: 100%;
		gap: 30px;
		&-item {
			font-size: 3rem;
			font-weight: 500;
			color: var(--text-dark);
			padding: 0;
		}
	}
</style>
