---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
	link?: boolean
	isFull?: boolean
	footerStyle?: boolean
}

const {
	class: className,
	link = false,
	isFull = false,
	footerStyle = false,
} = Astro.props
---

<button
	class:list={[
		{ 'btn-link': link },
		{ '!w-full': isFull },
		{ 'btn-footer': footerStyle },
		className,
	]}
>
	<slot />
</button>

<style lang="scss">
	button {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-white);
		font-family: 'Roboto';
		font-weight: 500;
		border-radius: 999px;
		font-size: 1.8rem;
		width: 17rem;
		padding: 1.5rem;
		background-color: var(--primary);
		cursor: pointer;
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease,
			filter 0.3s ease,
			background-color 0.3s ease,
			color 0.3s ease;
	}

	.btn-link {
		background-color: transparent;
		font-size: 1.6rem;
		font-weight: 400;
		justify-content: flex-start;
		gap: 4px;
		padding: 0;
		width: fit-content;
	}

	.btn-hero-hover {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background:
			linear-gradient(
				135deg,
				color-mix(in srgb, var(--primary) 92%, white 8%) 0%,
				var(--primary) 55%,
				color-mix(in srgb, var(--primary) 82%, black 18%) 100%
			);
		box-shadow:
			0 0 0 rgba(214, 75, 62, 0),
			0 8px 18px rgba(214, 75, 62, 0.16);

		&::before {
			content: '';
			position: absolute;
			inset: 0;
			background: linear-gradient(
				120deg,
				rgba(255, 255, 255, 0) 15%,
				rgba(255, 255, 255, 0.16) 50%,
				rgba(255, 255, 255, 0) 85%
			);
			transform: translateX(-140%);
			transition: transform 0.7s ease;
			z-index: -1;
		}

		&:hover {
			transform: translateY(-2px);
			box-shadow:
				0 14px 28px rgba(214, 75, 62, 0.2),
				0 0 18px rgba(214, 75, 62, 0.1);
			filter: brightness(1.03);

			&::before {
				transform: translateX(140%);
			}
		}

		&:focus-visible {
			outline: 2px solid var(--text-white);
			outline-offset: 4px;
			transform: translateY(-2px);
			box-shadow:
				0 12px 24px rgba(214, 75, 62, 0.18),
				0 0 0 4px rgba(255, 255, 255, 0.08);
		}
	}

	.btn-footer {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background-color: transparent;
		border: 1px solid var(--bg-white);
		color: var(--text-white);
		font-size: 2.4rem;
		font-family: 'Roboto';
		font-weight: 500;
		line-height: initial;
		box-shadow: 0 8px 18px rgba(214, 75, 62, 0);

		&::before {
			content: '';
			position: absolute;
			inset: 0;
			background: linear-gradient(
				135deg,
				color-mix(in srgb, var(--primary) 92%, white 8%) 0%,
				var(--primary) 55%,
				color-mix(in srgb, var(--primary) 82%, black 18%) 100%
			);
			opacity: 0;
			transition: opacity 0.3s ease;
			z-index: -2;
		}

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			background: linear-gradient(
				120deg,
				rgba(255, 255, 255, 0) 15%,
				rgba(255, 255, 255, 0.16) 50%,
				rgba(255, 255, 255, 0) 85%
			);
			transform: translateX(-140%);
			transition: transform 0.7s ease;
			z-index: -1;
		}

		&:hover {
			transform: translateY(-2px);
			background-color: transparent;
			box-shadow:
				0 14px 28px rgba(214, 75, 62, 0.2),
				0 0 18px rgba(214, 75, 62, 0.1);
			filter: brightness(1.03);

			&::before {
				opacity: 0;
			}

			&::after {
				transform: translateX(140%);
			}
		}

		&:focus-visible {
			outline: 2px solid var(--text-white);
			outline-offset: 4px;
			transform: translateY(-2px);
			background-color: transparent;
			box-shadow:
				0 12px 24px rgba(214, 75, 62, 0.18),
				0 0 0 4px rgba(255, 255, 255, 0.08);

			&::before {
				opacity: 0;
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		button,
		.btn-hero-hover,
		.btn-footer {
			transition: none;
		}

		.btn-hero-hover {
			&:hover,
			&:focus-visible {
				transform: none;
			}

			&::before {
				transition: none;
				transform: none;
			}
		}

		.btn-footer {
			&::before,
			&::after {
				transition: none;
			}

			&:hover,
			&:focus-visible {
				transform: none;
			}

			&::after {
				transform: none;
			}
		}
	}
</style>
