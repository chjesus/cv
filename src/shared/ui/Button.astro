---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
	link?: boolean
	isFull?: boolean
	footerStyle?: boolean
}

const {
	class: className,
	link = false,
	isFull = false,
	footerStyle = false,
} = Astro.props
---

<button
	class:list={[
		{ 'btn-link': link },
		{ '!w-full': isFull },
		{ 'btn-footer': footerStyle },
		className,
	]}
>
	<slot />
</button>

<style lang="scss">
	button {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-white);
		font-family: 'Roboto';
		border-radius: 999px;
		font-size: 1.8rem;
		width: 17rem;
		padding: 1.5rem;
		background-color: var(--primary);
	}

	.btn-link {
		background-color: transparent;
		font-size: 1.6rem;
		justify-content: flex-start;
		gap: 4px;
		padding: 0;
		width: fit-content;
	}

	.btn-footer {
		background-color: transparent;
		border: 1px solid var(--bg-white);
		color: var(--text-white);
		font-size: 2.4rem;
		font-family: 'Roboto';
		font-weight: 500;
		transition: all 0.3s;
    line-height: initial;
    cursor: pointer;
		&:hover {
			background-color: var(--bg-white);
			color: var(--text-dark);
		}
	}
</style>
