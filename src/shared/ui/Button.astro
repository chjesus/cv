---
type Props = {
	link?: boolean
	sFont?: string
	padding?: string
	className?: string
}

const { link = '', sFont = '', padding = '', className = '' } = Astro.props
---

<button class=`${sFont} ${padding} ${link && 'bg-transparent'} ${className}`>
	<slot />
</button>

<style>
	button {
		display: flex;
		align-items: center;
    justify-content: center;
		gap: 4px;
		color: var(--text);
		font-family: 'Roboto';
		border-radius: 999px;
		&:not(.bg-transparent) {
			background-color: var(--primary);
		}
	}
</style>
