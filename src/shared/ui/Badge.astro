---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
	fontSize?: string
}

const { class: className, fontSize } = Astro.props
---

<span
	class:list={[
		'badge',
		{ 'default-font-size': !fontSize },
		fontSize,
		className,
	]}
>
	<slot />
</span>

<style>
	.badge {
		font-family: 'Roboto';
		color: var(--text-dark);
		line-height: initial;
		background-color: #ffffff;
		border-radius: 0.68rem;
		position: relative;
		z-index: 10;
		padding: 0.8rem;
		max-width: 16.2rem;
		display: flex;
		justify-content: center;
		align-items: center;
		margin-bottom: 10px;
	}
	.default-font-size {
		font-size: 1.8rem;
	}
</style>
