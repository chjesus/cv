---
interface Props {
	sFont?: string
	padding?: string
	className?: string
}

const { padding, sFont, className } = Astro.props
---

<span class=`badge ${sFont} ${padding} ${className}`>
	<slot />
</span>

<style>
	.badge {
		font-family: 'Roboto';
		color: var(--text-dark);
		display: inline-block;
		line-height: initial;
		background-color: #ffffff;
		border-radius: 0.68rem;
	}
</style>
