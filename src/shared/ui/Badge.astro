---
const { class: className } = Astro.props
---

<span class:list={['badge', className]}>
	<slot />
</span>

<style lang="scss">
	.badge {
		font-family: 'Roboto';
		color: var(--text-dark);
		line-height: initial;
		background-color: var(--bg-white);
		border-radius: 0.68rem;
		position: relative;
		z-index: 10;
		padding: 0.8rem;
		max-width: 16.2rem;
		display: flex;
		justify-content: center;
		align-items: center;
		margin-bottom: 10px;
    height: fit-content;
    width: initial;
		font-size: 1.8rem;
	}
</style>
