---
type Props = {
	class?: string
	name?: string
	placeholder?: string
}

const { class: className = '', name, placeholder = '' } = Astro.props
---

<textarea rows="4" name={name} class:list={[className]} placeholder={placeholder}></textarea>

<style>
	textarea {
		padding: 1.7rem 2rem;
		border: 1px solid var(--white);
		background-color: transparent;
		border-radius: 3.4rem;
		width: 100%;
		font-size: 1.4rem;
		outline: none;
		color: var(--text-white);
		&::placeholder {
			color: var(--text-white);
			font-size: 1.4rem;
		}
	}
</style>
