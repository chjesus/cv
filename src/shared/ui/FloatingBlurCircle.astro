---
type Props = {
	blur: string
	size: string
	index?: string
	position?: string
	duration?: string
	delay?: string
}

const {
	blur,
	size,
	position = '',
	index = '',
	duration = '6s',
	delay = '0s',
} = Astro.props
---

<div class=`absolute pointer-events-none ${position} ${index}` aria-hidden="true">
	<div
		class="floating-blur-circle relative"
		style={{
			'--floating-blur-duration': duration,
			'--floating-blur-delay': delay,
		}}
	>
		<div class=`relative ${size}`>
			<div class=`blur_color absolute inset-0 h-full w-full ${blur}`></div>
			<slot />
		</div>
	</div>
</div>

<style lang="scss">
	.blur_color {
		background-color: var(--primary);
	}

	.floating-blur-circle {
		animation: floating-blur 6s ease-in-out infinite;
		animation-duration: var(--floating-blur-duration);
		animation-delay: var(--floating-blur-delay);
		will-change: transform;
	}

	@keyframes floating-blur {
		0%,
		100% {
			transform: translateY(0) scale(1);
		}

		25% {
			transform: translateY(-15px) scale(1.05);
		}

		50% {
			transform: translateY(8px) scale(0.95);
		}

		75% {
			transform: translateY(-8px) scale(1.02);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.floating-blur-circle {
			animation: none;
		}
	}
</style>
