---
type Props = {
	blur: string
	size: string
	index?: string
	position?: string
	duration?: string
	delay?: string
}

const {
	blur,
	size,
	position = '',
	index = '',
	duration = '6s',
	delay = '0s',
} = Astro.props
---

<div
	class=`absolute pointer-events-none ${position} ${index}`
	aria-hidden="true"
>
	<div
		class="floating-blur-circle relative"
		style={{
			'--floating-blur-duration': duration,
			'--floating-blur-delay': delay,
		}}
	>
		<div class=`relative ${size}`>
			<div class=`blur_color absolute inset-0 h-full w-full ${blur}`></div>
			<slot />
		</div>
	</div>
</div>

<style lang="scss">
	@use './scss/FloatingBlurCircle.scss';
</style>
