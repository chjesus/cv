---
import { Icon } from 'astro-icon/components'
type Props = {
	icon: string
	title: string
	description: string
}

const { icon, title, description } = Astro.props
---

<div class="card flex flex-col gap-8 xl:gap-10">
	<span class="card-icon cursor-pointer p-6">
		<Icon name={icon} />
	</span>
	<h3 class="card-title">{title}</h3>
	<p class="card-description">{description}</p>
</div>

<style lang="scss">
	.card {
		color: var(--text-white);
		border-radius: 1rem;
		padding: 2rem;
		align-items: flex-start;
		background-color: var(--bg-card-service);
		cursor: pointer;
		transition: all 0.3s ease-in-out;
		&-icon {
			background-color: var(--bg-white);
			color: var(--primary);
			border-radius: 999px;
			font-size: 2.6rem;
			border: 2px solid var(--primary);
		}
		&-title {
      font-family: 'Roboto';
			font-weight: 700;
			font-size: 2.4rem;
			text-align: left;
			color: var(--text-card-service-title);
		}
		&-description {
			text-align: left;
			font-weight: 400;
			line-height: normal;
			font-size: 1.6rem;
			color: var(--text-card-service-description);
		}
		&:hover {
			background-color: var(--primary);
			.card-title {
				color: var(--text-white);
			}
			.card-description {
				color: var(--text-white);
			}
			.card-icon {
				background-color: var(--bg-white-hover);
				color: var(--primary-hover);
				border-color: var(--primary-hover);
			}
		}
	}
</style>
