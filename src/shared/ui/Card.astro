---
import { Icon } from 'astro-icon/components'
type Props = {
	icon: string
	title: string
	description: string
}

const { icon, title, description } = Astro.props
---

<div class="card gap-[2.4rem] p-[18px]">
	<span class="card-icon cursor-pointer">
		<Icon name={icon} class="text-[2.6rem]" />
	</span>
	<h3 class="card-title text-[2.4rem]">{title}</h3>
	<p class="card-description text-[1.6rem]">{description}</p>
</div>

<style lang="scss">
	.card {
		display: flex;
		color: var(--text);
		border-radius: 10px;
		flex-direction: column;
		align-items: flex-start;
		background-color: var(--bg-card-service);
		cursor: pointer;
		transition: all 0.3s ease-in-out;
		&-icon {
			background-color: var(--bg-white);
			color: var(--primary);
			border-radius: 999px;
			padding: 1.6rem;
			border: 2px solid var(--primary);
		}
		&-title {
			font-weight: 700;
			text-align: left;
			color: var(--text-card-service-title);
		}
		&-description {
			text-align: left;
			font-weight: 400;
			line-height: normal;
			color: var(--text-card-service-description);
		}
		&:hover {
			background-color: var(--primary);
			.card-title {
				color: var(--text);
			}
			.card-description {
				color: var(--text);
			}
      .card-icon {
        background-color: var(--bg-white-hover);
        color: var(--primary-hover);
        border-color: var(--primary-hover);
      }
		}
	}
</style>
