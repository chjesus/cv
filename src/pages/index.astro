---
import Layout from '@app/layout/Layout.astro'
import Nav from '@app/layout/ui/Nav.astro'

import Header from '@widgets/Header.astro'
import About from '@widgets/About.astro'
import Experience from '@widgets/Experience.astro'
import Services from '@widgets/Services.astro'
import Contact from '@widgets/Contact.astro'
import Projects from '../sections/Projects.astro'
import Testimonials from '../sections/Testimonials.astro'
import Footer from '../sections/Footer.astro'
---

<Layout title="Jesus Chacon">
	<div class="page-container relative overflow-hidden bg-black">
		<Nav />
		<Header />
		<About />
		<Experience />
		<Services />
		<Contact />

		<!-- <div class="overflow-hidden">
			<Projects />
			<Testimonials />
			<Footer />
		</div> -->
	</div>
</Layout>

<style>
	.page-container {
		width: 100%;
		min-height: 100vh;
	}
</style>
