---
import Nav from '@app/layout/ui/Nav.astro'
import Layout from '@app/layout/Layout.astro'

import About from '@widgets/About.astro'
import Header from '@widgets/Header.astro'
import Footer from '@widgets/Footer.astro'
import Contact from '@widgets/Contact.astro'
import Services from '@widgets/Services.astro'
import Projects from '@widgets/Projects.astro'
import Experience from '@widgets/Experience.astro'
import Modal from '@shared/ui/Modal.astro'
---

<Layout title="Jesus Chacon | Frontend Developer">
	<div class="page-container bg-black">
		<Nav />
		<Header />
		<About />
		<Experience />
		<Services />
		<Contact />
		<Projects />
		<Footer />
	</div>
	<Modal />
</Layout>

<style>
	.page-container {
		width: 100%;
		min-height: 100vh;
		position: relative;
		overflow: hidden;
	}
</style>
