---
import Layout from '@app/layout/Layout.astro'
import AnimationFade from '@app/layout/ui/AnimationFade.astro'
import Container from '@app/layout/ui/Container.astro'
import { Icon } from 'astro-icon/components'
---

<Layout title="404 - Página no encontrada | JESÚS CHACÓN">
  <main>
    <section class="not-found relative flex items-center overflow-hidden">
      <div class="not-found__grid" aria-hidden="true"></div>

      <!-- Content -->
      <Container>
        <div class="not-found__content relative z-10">
          <AnimationFade translateY={30}>
            <div class="not-found__visual" aria-hidden="true">
              <div class="not-found__visual-glow"></div>
              <div class="not-found__panel">
                <div class="not-found__panel-gradient"></div>
                <div class="not-found__window-dots">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <img
                  src="/img/not-found-illustration.jpg"
                  alt=""
                  class="not-found__illustration"
                  loading="eager"
                  decoding="async"
                />
                <div class="not-found__status-card">
                  <p>Estado del proceso</p>
                  <div class="not-found__status-track">
                    <span></span>
                  </div>
                </div>
              </div>
            </div>
          </AnimationFade>

          <div class="not-found__copy">
            <AnimationFade translateY={-30}>
              <p class="not-found__eyebrow">Interrupción del sistema</p>
              <p class="not-found__title" aria-hidden="true">
                4<span class="not-found__zero">0</span>4
              </p>
            </AnimationFade>
            <AnimationFade translateY={30} delay={0.4}>
              <h1 class="not-found__heading">
                Error de ruta: <br />
                <span>Página no encontrada</span>
              </h1>
              <p class="not-found__description">
                Parece que el módulo que buscas fue descontinuado o movido a
                otra rama. Volvamos al repositorio principal.
              </p>
            </AnimationFade>
            <AnimationFade translateY={30} delay={0.7}>
              <div class="not-found__actions">
                <a href="/" class="not-found__btn btn-primary-premium">
                  <Icon name="heroicons:home-20-solid" />
                  Volver al portafolio
                </a>
                <button
                  type="button"
                  class="not-found__btn btn-secondary-premium"
                  data-history-back
                >
                  <Icon name="heroicons:arrow-left-20-solid" />
                  Regresar
                </button>
              </div>
              <div class="not-found__meta">
                <div>
                  <p>Código de estado</p>
                  <strong>RUTA_NO_DEFINIDA</strong>
                </div>
                <div>
                  <p>Entorno</p>
                  <strong>PRODUCCION_SEGURA</strong>
                </div>
              </div>
            </AnimationFade>
          </div>
        </div>
      </Container>
    </section>
  </main>

  <script></script>
</Layout>

<style lang="scss">
  @use './_scss/NotFound.scss';
</style>
