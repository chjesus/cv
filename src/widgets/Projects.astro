---
import Badge from '@shared/ui/Badge.astro'
import Title from '@shared/ui/Title.astro'
import Circle from '@shared/ui/Circle.astro'
import FloatingBlurCircle from '@shared/ui/FloatingBlurCircle.astro'
import Strong from '@shared/ui/Strong.astro'
import Container from '@app/layout/ui/Container.astro'
import CardProject from '@shared/ui/CardProject.astro'

import { PROJECTS } from '@shared/constants'

import AnimationFade from '@app/layout/ui/AnimationFade.astro'
---

<section class="portfolio py-24 md:py-48 overflow-hidden" id="portfolio">
	<Container>
		<div class="relative">
			<div class="portfolio-container grid grid-cols-1">
				<div class="relative z-10">
					<AnimationFade translateY={50}>
						<Badge class="m-auto md:m-0">Portfolio</Badge>
						<Title class="px-10 md:px-0 text-center md:text-left">
							Explore My Digital <Strong>Portfolio</Strong>
						</Title>
					</AnimationFade>
				</div>
				<div class="portfolio-project_list grid">
					{
						PROJECTS.map((project, index) => (
							<CardProject
								date={project.date}
								title={project.title}
								subtitle={project.subtitle}
								description={project.description}
								delay={parseFloat((index * 0.1).toFixed(1))}
								type={(index + 1) % 2 === 0 ? 'even' : 'odd'}
							/>
						))
					}
				</div>
			</div>
			<FloatingBlurCircle
				duration="8.75s"
				delay="-1.5s"
				position="hidden md:block -top-[6%] right-[20%]"
				blur="blur-[80px] md:blur-[210px]"
				size="size-[110px] lg:size-[188px] xl:size-[265px]"
			>
				<Circle
					size="size-[19px] md:size-[24px]"
					position="left-4 md:left-3/4 top-1/2"
				/>
			</FloatingBlurCircle>
			<FloatingBlurCircle
			  duration="6.5s"
				delay="-2.75s"
				position="top-0 -left-[10%] md:bottom-[14%] md:-left-[20%]"
				blur="blur-[90px]"
				size="size-[110px]"
			>
				<Circle size="size-[8px]" position="left-1/3 top-0" />
			</FloatingBlurCircle>
		</div>
	</Container>
</section>

<style lang="scss">
	@use './scss/Portfolio.scss';
</style>
