---
import Badge from '@shared/ui/Badge.astro'
import Title from '@shared/ui/Title.astro'
import Strong from '@shared/ui/Strong.astro'
import Container from '@app/layout/ui/Container.astro'
import CardProject from '@shared/ui/CardProject.astro'

import { PROJECTS } from '@shared/constants'
---

<section class="portfolio py-24 md:py-48">
	<Container>
		<div class="relative">
			<div class="portfolio-container grid grid-cols-1">
				<div>
					<Badge>Portfolio</Badge>
					<Title className="md:text-left">
						Explore My Digital <Strong>Portfolio</Strong>
					</Title>
				</div>
				<div class="portfolio-project_list grid grid-flow-row">
					{
						PROJECTS.map((project) => (
							<CardProject
								date={project.date}
								title={project.title}
								subtitle={project.subtitle}
								description={project.description}
							/>
						))
					}
				</div>
			</div>
		</div>
	</Container>
</section>

<style lang="scss">
  .portfolio {
    &-container {
      gap: 6rem;
    }
  }
	.portfolio-project_list {
		gap: 1.5rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		@media (min-width: 768px) {
			gap: 2rem;
		}
		@media (min-width: 1280px) {
			gap: 2.6rem;
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
