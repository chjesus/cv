---
import { Icon } from 'astro-icon/components'

import Container from '@app/layout/ui/Container.astro'
import logoHeaderUrl from '@shared/assets/img/logo_white.svg?url'
import FooterContactList from '@widgets/ui/FooterContactList.astro'
import FooterNavigationList from '@widgets/ui/FooterNavigationList.astro'
import FooterSocials from '@widgets/ui/FooterSocials.astro'
---

<footer class="footer w-full">
  <Container class="!max-w-[1280px]">
    <div class="footer-grid grid gap-[4rem] max-[767px]:gap-[4rem]">
      <h2 class="footer-title">Conectemos</h2>
      <div class="footer-brand__logo flex items-center">
        <img src={logoHeaderUrl} alt="Logo de Jesús Chacón" />
        <p class="footer-brand__description">
          Creando experiencias digitales excepcionales con interfaces modernas,
          rápidas y diseño limpio.
        </p>
        <FooterSocials class="max-md:hidden" />
      </div>
      <a class="footer-cta__button btn-primary-premium" href="#contact">
        Contrátame <Icon name="heroicons:arrow-up-right-20-solid" />
      </a>
      <div class="footer-links-group">
        <nav class="footer-nav" aria-label="Navegación del pie de página">
          <h4>Navegación</h4>
          <FooterNavigationList />
        </nav>
        <div class="footer-contact">
          <h4>Contacto</h4>
          <FooterContactList />
        </div>
      </div>

      <form class="footer-newsletter">
        <h4>Recibe la información más reciente</h4>
        <div class="footer-newsletter__field">
          <input
            id="footer-email"
            type="email"
            placeholder="Correo electrónico"
            aria-label="Correo electrónico"
          />
          <button type="submit" aria-label="Suscribirse">
            <Icon name="iconamoon:send-fill" />
          </button>
        </div>
      </form>
      <FooterSocials class="md:hidden" />
    </div>
  </Container>
  <div class="footer-bottom gap-[1.6rem] py-[2rem]">
    <Container class="!max-w-[1280px]">
      <div class="footer-bottom__copyright gap-[1.6rem]">
        <p>Copyright© 2026 Jesús Chacón. Todos los derechos reservados.</p>
        <div class="footer-bottom__links flex gap-[2.4rem]">
          <a>Términos y condiciones</a>
          <a>Política de privacidad</a>
        </div>
      </div>
    </Container>
  </div>
</footer>

<style lang="scss">
  @use './scss/Footer.scss';
</style>
