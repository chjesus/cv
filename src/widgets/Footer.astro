---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'

import Container from '@app/layout/ui/Container.astro'
import Button from '@shared/ui/Button.astro'
import Circle from '@shared/ui/Circle.astro'
import FloatingBlurCircle from '@shared/ui/FloatingBlurCircle.astro'

import AnimationFade from '@app/layout/ui/AnimationFade.astro'

import { PUBLIC_URL_BUCKET } from '@shared/constants/env'
---

<footer class="footer">
	<Container isFooter={true}>
		<div class="relative py-14 md:pb-10 md:pt-20 xl:pb-12 xl:pt-28">
			<div class="footer-container gap-y-12 md:gap-x-10 xl:gap-y-0">
				<div class="justify-self-center md:col-span-3 md:justify-self-start">
					<h1 class="footer-title md:mb-20 xl:mb-24">Lets Connect there</h1>
				</div>
				<div class="row-start-3 md:row-start-auto md:justify-self-end">
					<Button footerStyle={true} class="mx-auto md:mb-20 xl:mb-24">
						Hire me
					</Button>
				</div>
				<div class="md:col-span-2 md:self-start">
					<AnimationFade translateX={-50} delay={0}>
						<Image
							class="mx-auto object-cover md:m-0"
							src={`${PUBLIC_URL_BUCKET}/img/logo_white.svg`}
							alt="Logo Jesus DEV"
							width={200}
							height={60}
						/>
						<p class="footer-description mt-6 md:mt-0">
							Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed
							congue interdum ligula a dignissim. Lorem ipsum dolor sit amet,
							consectetur adipiscing elit. Sed lobortis orci elementum egestas
							lobortis.
						</p>
					</AnimationFade>
				</div>
				<div class="row-start-6 md:col-span-2 md:row-start-3 md:self-start">
					<AnimationFade translateX={-50} delay={0}>
						<div class="footer-social_media_list">
							<a
								href="https://github.com/chjesus"
								target="_blank"
								rel="noopener noreferrer"
								class="footer-social_media_item"
                aria-label="Perfil de github"
							>
								<Icon name="mingcute:github-fill" />
							</a>
							<a
								class="footer-social_media_item"
								href="https://x.com/ch__jesus"
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Perfil de x"
							>
								<Icon name="mingcute:social-x-fill" />
							</a>
							<a
								class="footer-social_media_item"
								href="https://www.linkedin.com/in/jesus-chacon-510643162/"
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Perfil de linkedin"
							>
								<Icon name="mingcute:linkedin-fill" />
							</a>
						</div>
					</AnimationFade>
				</div>
				<div class="self-start md:row-span-2">
					<AnimationFade translateX={-50} delay={0.3}>
						<div class="flex gap-14">
						<ul class="footer-list">
							<li class="footer-list_item">Navigation</li>
							<li class="footer-list_item">
								<a href="#home">Home</a>
							</li>
							<li class="footer-list_item">
								<a href="#about">About</a>
							</li>
							<li class="footer-list_item">
								<a href="#services">Services</a>
							</li>
							<li class="footer-list_item">
								<a href="#portfolio">Portfolio</a>
							</li>
							<li class="footer-list_item">
								<a href="#contact">Contact</a>
							</li>
						</ul>
						<ul class="footer-list">
							<li class="footer-list_item">Contact</li>
							<li class="footer-list_item">jesus_chacon@gmail.com</li>
						</ul>
						</div>
					</AnimationFade>
				</div>
				<div class="self-start">
					<AnimationFade translateX={-50} delay={0.6}>
						<div class="flex flex-col gap-11">
							<h2 class="footer-subtitle">Get the latest information</h2>
							<label class="flex" for="email">
								<input
									type="email"
									placeholder="Email Address"
									class="footer-input"
									id="email"
									name="email"
									aria-label="Email Address"
								/>
								<span class="footer-input_icon">
									<Icon name="iconamoon:send-fill" />
								</span>
							</label>
						</div>
					</AnimationFade>
				</div>
			</div>
			<FloatingBlurCircle
				duration="7.5s"
				delay="-1s"
				position="hidden md:block top-[8%] left-[6%]"
				blur="blur-[120px]"
				size="size-[140px] md:size-[180px]"
			>
				<Circle
					size="size-[12px] md:size-[18px]"
					position="top-1/3 left-1/4"
				/>
			</FloatingBlurCircle>
			<FloatingBlurCircle
				duration="8.75s"
				delay="-3s"
				position="bottom-[18%] right-[4%] md:bottom-[20%] md:right-[10%]"
				blur="blur-[100px] md:blur-[140px]"
				size="size-[120px] md:size-[170px]"
			>
				<Circle
					size="size-[10px] md:size-[16px]"
					position="top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
				/>
			</FloatingBlurCircle>
		</div>
	</Container>
	<div class="footer-bottom py-8">
		<Container>
			<div class="grid grid-cols-1 justify-between md:grid-cols-2">
				<span class="footer-bottom__item md:!justify-self-start">
					Copyright© 2026 Jesus Chacon. All Rights Reserved.
				</span>
				<span class="footer-bottom__item md:!justify-self-end">
					User Terms & Conditions | Privacy Policy
				</span>
			</div>
		</Container>
	</div>
</footer>

<style lang="scss">
	@use './scss/Footer.scss';
</style>
