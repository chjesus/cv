---
import Container from '@app/layout/ui/Container.astro'
import IMAGEHEADER from '@shared/assets/img/header.svg'
import DownloadCV from '@widgets/ui/DownloadCV.astro'
import { Icon } from 'astro-icon/components'
---

<header class="premium-section hero" id="home">
  <Container class="w-full !max-w-[1280px]">
    <div class="hero-shell">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-grid relative grid grid-cols-[minmax(0,7fr)_minmax(34rem,5fr)] items-center gap-[2.4rem] max-[900px]:grid-cols-1">
        <div class="hero-copy relative z-[1] flex flex-col gap-[2.4rem]">
          <span class="premium-badge">Hola</span>
          <h1 class="premium-display">
            Creando <br />
            <span class="text-luminous">Interfaces Frontend</span> con <br />
            Diseño Preciso
          </h1>
          <p class="premium-copy hero-description mt-[1.6rem] max-w-[60rem]">
            Desarrollo aplicaciones web escalables y de alto rendimiento,
            enfocadas en experiencias de usuario excepcionales y arquitectura
            sólida. Desarrollador Frontend, construido con confianza serena.
          </p>
          <div class="hero-actions mt-[1.6rem] flex flex-wrap gap-[1.6rem]">
            <a class="btn-primary-premium" href="#contact">
              Contrátame <Icon name="formkit:arrowright" />
            </a>
            <a class="btn-secondary-premium" href="#portfolio">
              Ver Portafolio
            </a>
          </div>
        </div>

        <div
          class="hero-visual relative"
          aria-label="Ilustración del espacio de trabajo del desarrollador"
        >
          <div class="hero-visual__inner glass-card absolute inset-0 grid place-items-center">
            <div class="hero-visual__wash"></div>
            <IMAGEHEADER class="hero-visual__image relative z-[1] h-auto max-h-[88%] w-[92%] object-contain" />
          </div>
        </div>
      </div>
    </div>
    <DownloadCV />
  </Container>
</header>

<style lang="scss">
  @use './scss/Header.scss';
</style>
