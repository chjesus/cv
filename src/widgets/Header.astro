---
import { Image } from 'astro:assets'

import HeaderImage from '@shared/assets/amico.svg'
import ArrowRight from '@shared/ui/icons/ArrowRight.astro'
import BlurCircle from '@shared/ui/BlurCircle.astro'
import Circle from '@shared/ui/Circle.astro'
import Button from '@shared/ui/Button.astro'
import Badge from '@shared/ui/Badge.astro'
---

<header class="header flex py-24 md:py-48">
	<div class="mx-auto max-w-screen-xl px-[20px] lg:px-[70px] xl:px-0">
		<div class="relative">
			<div class="grid grid-cols-1 md:grid-cols-2">
				<div class="flex flex-col items-center justify-center md:items-start">
					<div class="mx-auto md:ml-0">
						<Badge sFont="text-[15px]" padding="px-4 py-2">Hello There</Badge>
					</div>
					<h1 class="header-title text-center md:text-left">
						<strong> Experience the Mastery </strong>
						Explore my Website Creations.
					</h1>
					<p
						class="header-description text-[12px] lg:text-[14px] xl:text-[20px]"
					>
						Welcome to my portfolio of captivating digital experiences. Explore
						my work and let's create something extraordinary together.
					</p>
					<div class="grid auto-cols-max grid-flow-col gap-10">
						<Button
							sFont="text-[12px] xl:text-[18px]"
							padding="px-[24px] xl:px-[55px] py-[6px] xl:py-[15px]"
						>
							Hire me
						</Button>
						<Button sFont="text-[12px] xl:text-[16px]" link={true}>
							View Portfolio
							<ArrowRight class="size-3.5 fill-white" />
						</Button>
					</div>
				</div>
				<div
					class="mt-12 flex items-center justify-center md:mt-0 md:justify-end"
				>
					<figure>
						<Image src={HeaderImage} alt="Amico" />
					</figure>
				</div>
			</div>
			<BlurCircle
				position="hidden md:block top-1/3 left-2/4"
				blur="blur-[100px]"
				size="size-[110px]"
			>
				<Circle size="size-[8px]" position="left-1/3 top-0" />
			</BlurCircle>
			<BlurCircle
				position="top-[40%] md:-top-[20%] -right-48 md:-right-[10%]"
				blur="blur-[80px] md:blur-[210px]"
				size="size-[110px] lg:size-[188px] xl:size-[265px]"
			>
				<Circle
					size="size-[19px] md:size-[24px]"
					position="left-4 md:left-3/4 top-1/2"
				/>
			</BlurCircle>
		</div>
	</div>
</header>

<style>
	.header {
		width: 100%;

		@media (min-width: 1280px) {
			align-items: center;
			min-height: 100vh;
		}
	}

	.header-title {
		font-weight: 900;
		font-size: 28px;
		font-family: 'Roboto';
		line-height: 33px;
		color: var(--text);

		strong {
			color: var(--primary);
		}

		@media (min-width: 768px) {
			font-size: 36px;
			line-height: 42px;
		}

		@media (min-width: 998px) {
			font-size: 44px;
			line-height: 52px;
		}

		@media (min-width: 1280px) {
			font-size: 62px;
			line-height: 73px;
		}
	}

	.header-description {
		font-weight: normal;
		font-family: 'Cardo';
		color: var(--text);
		text-align: center;
		padding: 24px 0;

		@media (min-width: 768px) {
			text-align: left;
		}

		@media (min-width: 1024px) {
			text-align: left;
		}
	}

	@media (min-width: 768px) {
		figure {
			max-width: 300px;
		}
	}

	@media (min-width: 998px) {
		figure {
			max-width: 330px;
		}
	}

	@media (min-width: 1280px) {
		figure {
			max-width: 470px;
		}
	}
</style>
