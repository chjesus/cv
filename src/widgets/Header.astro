---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'

import HeaderImage from '@shared/assets/amico.svg'
import BlurCircle from '@shared/ui/BlurCircle.astro'
import Circle from '@shared/ui/Circle.astro'
import Button from '@shared/ui/Button.astro'
import Badge from '@shared/ui/Badge.astro'
---

<header class="header flex py-36 md:py-48">
	<div class="mx-auto max-w-screen-xl px-[20px] lg:px-[70px] xl:px-0">
		<div class="relative">
			<div class="grid grid-cols-1 md:grid-cols-2">
				<div class="flex flex-col items-center justify-center md:items-start">
					<div class="mx-auto md:ml-0">
						<Badge fontSize="text-[1.5rem]">Hello There</Badge>
					</div>
					<h1 class="header-title text-center md:text-left">
						<strong>Experience the Mastery</strong>
						Explore my Website Creations.
					</h1>
					<p class="header-description text-center md:text-left">
						Welcome to my portfolio of captivating digital experiences. Explore
						my work and let's create something extraordinary together.
					</p>
					<div class="grid auto-cols-max grid-flow-col gap-10">
						<Button>Hire me</Button>
						<Button link={true}>
							View Portfolio
							<Icon name="formkit:arrowright" />
						</Button>
					</div>
				</div>
				<div
					class="mt-12 flex items-center justify-center md:mt-0 md:justify-end"
				>
					<figure class="w-full">
						<Image src={HeaderImage} alt="Amico" />
					</figure>
				</div>
			</div>
			<BlurCircle
				position="hidden md:block top-1/3 left-2/4"
				blur="blur-[100px]"
				size="size-[110px]"
			>
				<Circle size="size-[8px]" position="left-1/3 top-0" />
			</BlurCircle>
			<BlurCircle
				position="top-[40%] md:-top-[20%] -right-48 md:-right-[10%]"
				blur="blur-[80px] md:blur-[210px]"
				size="size-[110px] lg:size-[188px] xl:size-[265px]"
			>
				<Circle
					size="size-[19px] md:size-[24px]"
					position="left-4 md:left-3/4 top-1/2"
				/>
			</BlurCircle>
		</div>
	</div>
</header>

<style lang="scss">
	.header {
		width: 100%;

		@media (min-width: 1280px) {
			align-items: center;
			min-height: 100vh;
		}
	}

	.header-title {
		font-weight: 900;
		font-size: 4rem;
		font-family: 'Roboto';
		line-height: normal;
		color: var(--text);

		strong {
			color: var(--primary);
		}

		@media (min-width: 768px) {
			font-size: 4.5rem;
		}

		@media (min-width: 998px) {
			font-size: 5rem;
		}

		@media (min-width: 1280px) {
			font-size: 6.2rem;
		}
	}

	.header-description {
		font-weight: normal;
		font-size: 2rem;
		font-family: 'Cardo';
		color: var(--text);
		padding: 24px 0;
	}

	@media (min-width: 768px) {
		figure {
			max-width: 37.5rem;
		}
	}

	@media (min-width: 1280px) {
		figure {
			max-width: 47rem;
		}
	}
</style>
