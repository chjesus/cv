---
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'

import Text from '@shared/ui/Text.astro'
import Badge from '@shared/ui/Badge.astro'
import Title from '@shared/ui/Title.astro'
import Circle from '@shared/ui/Circle.astro'
import Strong from '@shared/ui/Strong.astro'
import FloatingBlurCircle from '@shared/ui/FloatingBlurCircle.astro'
import Container from '@app/layout/ui/Container.astro'

import AnimationFade from '@app/layout/ui/AnimationFade.astro'

import { PUBLIC_URL_BUCKET } from '@shared/constants/env'
---

<section class="about pb-40 pt-40" id="about">
	<Container>
		<div class="relative lg:px-14">
			<div class="about-container grid grid-cols-1 md:grid-cols-[auto_1fr]">
				<div class="order-2 mx-auto md:order-1">
					<AnimationFade translateY={50}>
						<figure class="about-image relative">
							<Image
								class="relative z-10 w-full cursor-pointer"
								src={`${PUBLIC_URL_BUCKET}/img/foto.png`}
								alt="Foto de perfil"
								width={400}
								height={400}
							/>
						</figure>
					</AnimationFade>
				</div>
				<div class="order-1 text-center md:order-2 md:text-left">
					<AnimationFade translateX={50}>
						<Badge class="mx-auto md:mx-0">About me</Badge>
						<Title class="mb-14 uppercase">
							<Strong>Jesus</Strong> Chacon
						</Title>
					</AnimationFade>
					<AnimationFade translateX={50} delay={0.6}>
						<Text class="mb-12">
							Lorem Ipsum is simply dummy text of the printing and typesetting
							industry. Lorem Ipsum has been the industry's standard dummy text
							ever since the 1500s.
						</Text>
						<Text class="mb-12">
							It has survived not only five centuries, but also the leap into
							electronic typesetting, remaining essentially unchanged.
						</Text>
					</AnimationFade>
					<AnimationFade translateX={50}>
						<h3 class="about-subtitle mb-10">Skills</h3>
						<div class="about-icon__list grid gap-6">
							<Icon name="catppuccin:html" class="text-9xl" />
							<Icon name="catppuccin:css3" class="text-9xl" />
							<Icon name="catppuccin:javascript" class="text-9xl" />
							<Icon name="catppuccin:javascript-react" class="text-9xl" />
							<Icon name="catppuccin:next" class="text-9xl" />
							<Icon name="catppuccin:astro" class="text-9xl" />
							<Icon name="catppuccin:vite" class="text-9xl" />
						</div>
					</AnimationFade>
				</div>
			</div>
			<FloatingBlurCircle
				duration="7s"
				delay="-1s"
				position="hidden md:block -top-[10%] -left-[16%]"
				blur="blur-[170px]"
				size="size-[207px]"
			/>
			<FloatingBlurCircle
				duration="8.5s"
				delay="-3s"
				position="top-1/2 right-[62%] md:top-0 md:right-0"
				blur="blur-[110px]"
				size="size-[170px] md:size-[125px]"
			>
				<Circle
					size="size-[22px]"
					position="top-3/4 left-1/4 md:left-1/3 md:top-0"
				/>
			</FloatingBlurCircle>
		</div>
	</Container>
</section>

<style lang="scss">
	@use './scss/About.scss';
</style>
