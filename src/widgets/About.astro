---
import Container from '@app/layout/ui/Container.astro'
import { Icon } from 'astro-icon/components'

const skills = [
  'catppuccin:html',
  'catppuccin:css3',
  'catppuccin:javascript',
  'catppuccin:javascript-react',
  'catppuccin:next',
  'catppuccin:astro',
  'catppuccin:vite',
]
---

<section class="premium-section about" id="about">
  <Container class="!max-w-[1280px]">
    <div
      class="about-grid grid grid-cols-[minmax(28rem,5fr)_minmax(0,7fr)] items-center gap-[10.4rem] max-[820px]:grid-cols-1"
    >
      <figure
        class="about-image glass-panel max-[820px]:order-2 max-[820px]:mx-auto max-[820px]:max-w-[38rem]"
      >
        <img
          src="/img/profile.png"
          alt="Jesús Chacón"
          width="460"
          height="460"
        />
      </figure>

      <div
        class="about-content flex flex-col items-start gap-[2.4rem] max-[820px]:order-1"
      >
        <span class="premium-badge">Sobre mí</span>
        <h2 class="premium-title">
          <span class="text-luminous">JESÚS</span>
          CHACÓN
        </h2>
        <p class="premium-copy">
          Soy Ingeniero en Informática y Desarrollador Frontend con más de 8
          años de experiencia creando interfaces modernas, escalables y
          enfocadas en la experiencia de usuario. Mi trabajo se centra en React,
          Next.js y Astro, construyendo productos web sólidos con atención al
          detalle visual y técnico.
        </p>
        <p class="premium-copy">
          Me especializo en crear sistemas de interfaz claros y mantenibles,
          trabajando con CSS moderno y librerías como MUI y Ant Design. Además,
          soy entusiasta de las computadoras y los videojuegos, una pasión que
          alimenta mi curiosidad por la tecnología, el rendimiento y las
          experiencias digitales bien diseñadas.
        </p>

        <div class="about-skills mt-[0.8rem] flex flex-col gap-[1.6rem]">
          <h3>Habilidades</h3>
          <div class="about-skills__grid flex flex-wrap gap-[1.6rem]">
            {
              skills.map((skill) => (
                <span
                  class="about-skill grid h-[4.8rem] w-[4.8rem] place-items-center"
                  title={skill.split(':')[1]}
                >
                  <Icon name={skill} />
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style lang="scss">
  @use './scss/About.scss';
</style>
