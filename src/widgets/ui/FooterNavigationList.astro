---
const navItems = [
  { label: 'Inicio', href: '#home' },
  { label: 'Sobre mí', href: '#about' },
  { label: 'Servicios', href: '#services' },
  { label: 'Portafolio', href: '#portfolio' },
]
---

<ul class="footer-navigation-list">
  {navItems.map(({ label, href }) => (
    <li>
      <a href={href}>{label}</a>
    </li>
  ))}
</ul>

<style lang="scss">
  @use './scss/FooterNavigationList.scss';
</style>
