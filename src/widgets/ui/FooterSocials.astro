---
import { Icon } from 'astro-icon/components'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<div class:list={['footer-socials flex gap-[1.6rem]', className]}>
  <a
    href="https://github.com/chjesus"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Perfil de GitHub"
  >
    <Icon name="mdi:github" />
  </a>
  <a
    href="https://x.com/ch__jesus"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Perfil de X"
  >
    <Icon name="heroicons:bolt-20-solid" />
  </a>
  <a
    href="https://www.linkedin.com/in/jesus-chacon-510643162/"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Perfil de LinkedIn"
  >
    <Icon name="mdi:linkedin" />
  </a>
</div>

<style lang="scss">
  @use './scss/FooterSocials.scss';
</style>
