---
import Container from '@app/layout/ui/Container.astro'
import { Icon } from 'astro-icon/components'

const testimonials = [
  {
    quote: [
      'Tuve la oportunidad de trabajar con Jesús como desarrollador Frontend y puedo recomendar ampliamente su trabajo.',
      'Es una persona que se destaca tanto por su capacidad técnica como por su excelente actitud. Tiene mucha facilidad para entender los retos, proponer soluciones y llevarlas a la práctica de manera ágil y efectiva. Durante el tiempo que trabajamos juntos demostró ser muy resolutivo, autónomo y siempre dispuesto a aportar cuando el equipo lo necesitaba.',
      'Además de ser técnicamente muy bueno, valoro especialmente su disposición, compromiso y forma de afrontar los desafíos. Es de esas personas con las que da gusto trabajar porque, ante un problema, se enfoca rápidamente en encontrar cómo resolverlo.',
      'Sin duda, es un excelente profesional y una persona que recomendaría para cualquier equipo de desarrollo.',
    ],
    name: 'Fabian Devia Saenz',
    role: 'Gerente de Tecnologia y Desarrollo',
    initials: 'FD',
    profileUrl: 'https://www.linkedin.com/in/fabian-devia-saenz-930850127/',
  },
  {
    quote: [
      'Jesus helped us build an interactive multi-language web application where our customers at https://divainparfums.es/ can access to choose free perfume samples.',
      'He successfully integrated our product team, composed of UX/UI designers, backend, and product manager, and brought good ideas to the development.',
      'We are very happy with his work and hope to count on him for future projects.',
    ],
    name: 'Tomas R. Pita',
    role: 'Software Engineer',
    initials: 'TP',
    profileUrl: 'https://www.linkedin.com/in/tomasrpita/',
  },
]
---

<section class="premium-section testimonials" id="testimonials">
  <Container class="!max-w-[1280px]">
    <div class="testimonials-header mb-[6.4rem] flex flex-col items-start gap-[1.6rem]">
      <span class="premium-badge">Testimonios</span>
      <h2 class="premium-title">
        Testimonios que Hablan de <span class="text-luminous">Resultados</span>
      </h2>
      <p class="premium-copy">
        Una colección de opiniones y experiencias de clientes y colaboradores
        con quienes he tenido el placer de trabajar.
      </p>
    </div>

    <div class="testimonials-grid grid grid-cols-2 items-start gap-[2.4rem] max-[820px]:grid-cols-1">
      {testimonials.map((testimonial) => (
        <article class="testimonial-card glass-card mouse-track-container group flex flex-col p-[3.2rem] max-[820px]:p-[2.8rem]">
          <div class="glow-overlay" />
          <div class="testimonial-card__stars relative z-[1] mb-[1.6rem] flex gap-[0.4rem]">
            {Array.from({ length: 5 }).map(() => (
              <Icon name="heroicons:star-20-solid" />
            ))}
          </div>
          <div
            class:list={[
              'testimonial-card__quote',
              testimonial.quote.length > 1 && 'is-collapsed',
            ]}
            data-testimonial-quote
          >
            {testimonial.quote.map((paragraph, index) => (
              <p>
                {index === 0 && '“'}
                {paragraph}
                {index === testimonial.quote.length - 1 && '”'}
              </p>
            ))}
          </div>
          {testimonial.quote.length > 1 && (
            <button
              class="testimonial-card__toggle"
              type="button"
              data-testimonial-toggle
              aria-expanded="false"
            >
              Mostrar más...
            </button>
          )}
          <a
            class="testimonial-card__link group/link relative z-[1] mt-auto mb-[2.4rem] inline-flex w-fit items-center gap-[0.8rem]"
            href={testimonial.profileUrl ?? '#portfolio'}
            target={testimonial.profileUrl ? '_blank' : undefined}
            rel={testimonial.profileUrl ? 'noopener noreferrer' : undefined}
          >
            <span>Visitar sitio</span>
            <Icon name="heroicons:arrow-top-right-on-square-20-solid" />
          </a>
          <div class="testimonial-card__author relative z-[1] flex items-center gap-[1.6rem]">
            <span class="grid h-[4.8rem] w-[4.8rem] place-items-center">
              {testimonial.initials}
            </span>
            <div>
              <h3>{testimonial.name}</h3>
              <strong>{testimonial.role}</strong>
            </div>
          </div>
        </article>
      ))}
    </div>
  </Container>
</section>

<style lang="scss">
  @use './scss/Testimonials.scss';
</style>

<script>
  const testimonialCards = document.querySelectorAll('.testimonial-card')

  testimonialCards.forEach((card) => {
    if (!(card instanceof HTMLElement)) return

    card.addEventListener('mousemove', (event) => {
      const rect = card.getBoundingClientRect()

      card.style.setProperty('--mouse-x', `${event.clientX - rect.left}px`)
      card.style.setProperty('--mouse-y', `${event.clientY - rect.top}px`)
    })
  })

  const testimonialToggles = document.querySelectorAll(
    '[data-testimonial-toggle]',
  )

  testimonialToggles.forEach((toggle) => {
    if (!(toggle instanceof HTMLButtonElement)) return

    toggle.addEventListener('click', () => {
      const card = toggle.closest('.testimonial-card')
      const quote = card?.querySelector('[data-testimonial-quote]')

      if (!(quote instanceof HTMLElement)) return

      const isExpanded = toggle.getAttribute('aria-expanded') === 'true'

      quote.classList.toggle('is-collapsed', isExpanded)
      toggle.setAttribute('aria-expanded', String(!isExpanded))
      toggle.textContent = isExpanded ? 'Mostrar más...' : 'Mostrar menos'
    })
  })
</script>
