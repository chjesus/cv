---
import { Image } from 'astro:assets'

import ExperienceImage from '@shared/assets/Group.svg'

import Badge from '@shared/ui/Badge.astro'
import Title from '@shared/ui/Title.astro'
import Text from '@shared/ui/Text.astro'
import Strong from '@shared/ui/Strong.astro'
import Button from '@shared/ui/Button.astro'
import Input from '@shared/ui/Input.astro'
import TextArea from '@shared/ui/TextArea.astro'
import Container from '@app/layout/ui/Container.astro'

import AnimationFade from '@app/layout/ui/AnimationFade'
---

<section class="contact py-24 md:py-48">
	<Container>
		<div class="relative">
			<div class="contact-container grid grid-cols-1 gap-24 md:gap-16">
				<div class="flex flex-col md:items-start">
					<AnimationFade tranlasteX={-50} client:visible>
						<Badge class="m-auto">Let’s contact</Badge>
					</AnimationFade>
					<AnimationFade tranlasteX={-50} client:visible>
						<div class="flex flex-col gap-[20px]">
              <Title class="text-center md:text-left">
                Have an Awsome Project Idea? <Strong>Let’s Discuss</Strong>
              </Title>
              <Text class="text-center md:text-left">
                Ready to take your company to the next level? Contact us to
                discuss your goals and how we can help you achieve them.
              </Text>
              <form class="flex w-full flex-col gap-[20px]">
                <Input type="email" placeholder="Enter Email Address" />
                <Input type="text" placeholder="Enter Your Name" />
                <TextArea placeholder="Enter Message" />
              </form>
              <Button isFull={true}>Send</Button>
            </div>
					</AnimationFade>
				</div>
				<AnimationFade tranlasteX={50} client:visible>
					<Image
						class="mx-auto h-full w-min md:ml-auto md:mr-0"
						src={ExperienceImage}
						alt="Experience Image"
					/>
				</AnimationFade>
			</div>
		</div>
	</Container>
</section>

<style lang="scss">
	@import './scss/Contact.scss';
</style>
