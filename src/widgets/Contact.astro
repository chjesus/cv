---
import Container from '@app/layout/ui/Container.astro'
import { Icon } from 'astro-icon/components'
---

<section class="premium-section contact" id="contact">
  <Container class="!max-w-[1280px]">
    <div class="contact-grid grid grid-cols-[minmax(0,7fr)_minmax(36rem,5fr)] items-center gap-[2.4rem] max-[900px]:grid-cols-1">
      <div class="contact-copy flex flex-col items-start gap-[2.4rem]">
        <span class="premium-badge">Contacto</span>
        <h2 class="premium-title">
          Construyamos Algo <span class="text-luminous">Excepcional</span>
        </h2>
        <p class="premium-copy">
          ¿Tienes un proyecto en mente o quieres conversar sobre oportunidades?
          Actualmente estoy disponible para trabajos freelance y posiciones de
          tiempo completo.
        </p>

        <form
          class="contact-form grid w-full gap-[2.4rem]"
          action="/api/contact"
          method="POST"
          data-contact-form
        >
          <label class="grid gap-[0.8rem]">
            <span>Nombre</span>
            <input
              id="name"
              name="name"
              type="text"
              placeholder="John Doe"
              required
            />
          </label>
          <label class="grid gap-[0.8rem]">
            <span>Correo electrónico</span>
            <input
              id="email"
              name="email"
              type="email"
              placeholder="john@example.com"
              required
            />
          </label>
          <label class="grid gap-[0.8rem]">
            <span>Mensaje</span>
            <textarea
              id="message"
              name="message"
              placeholder="Cuéntame sobre tu proyecto..."
              required
            ></textarea>
          </label>
          <button
            class="btn-primary-premium justify-self-start"
            type="submit"
            data-contact-submit
          >
            Enviar Mensaje
          </button>
          <p
            class="contact-form__status"
            data-contact-status
            aria-live="polite"
          ></p>
        </form>
      </div>

      <div
        class="contact-visual relative grid aspect-square place-items-center max-[900px]:hidden"
        aria-hidden="true"
      >
        <div class="contact-visual__glow"></div>
        <div class="contact-visual__card glass-card grid aspect-square w-[74%] place-items-center">
          <Icon name="heroicons:envelope-20-solid" />
        </div>
      </div>
    </div>
  </Container>
</section>

<style lang="scss">
  @use './scss/Contact.scss';
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]')
  const submitButton = document.querySelector<HTMLButtonElement>(
    '[data-contact-submit]',
  )
  const statusMessage = document.querySelector<HTMLElement>(
    '[data-contact-status]',
  )

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()

    if (!statusMessage || !submitButton) return

    submitButton.disabled = true
    statusMessage.dataset.state = 'loading'
    statusMessage.textContent = 'Enviando mensaje...'

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
      })
      const result = (await response.json()) as { message?: string }

      if (!response.ok) {
        throw new Error(result.message ?? 'No se pudo enviar el mensaje.')
      }

      statusMessage.dataset.state = 'success'
      statusMessage.textContent =
        result.message ?? 'Mensaje enviado correctamente.'
      form.reset()
    } catch (error) {
      statusMessage.dataset.state = 'error'
      statusMessage.textContent =
        error instanceof Error
          ? error.message
          : 'No se pudo enviar el mensaje. Inténtalo nuevamente.'
    } finally {
      submitButton.disabled = false
    }
  })
</script>
