---
import { Image } from 'astro:assets'
import ExperienceImage from '@shared/assets/Group.svg'

import {
	EXPERIENCE_WORK_LIST,
	EXPERIENCE_EDUCATION_LIST,
} from '@shared/constants'

import Badge from '@shared/ui/Badge.astro'
import BlurCircle from '@shared/ui/BlurCircle.astro'
import Circle from '@shared/ui/Circle.astro'
import Title from '@shared/ui/Title.astro'
import SubTitle from '@shared/ui/SubTitle.astro'
import Text from '@shared/ui/Text.astro'
import Strong from '@shared/ui/Strong.astro'
import Container from '@app/layout/ui/Container.astro'
---

<section class="experience py-24 md:py-48">
	<Container>
		<div class="relative">
			<div class="text-center md:text-left">
				<Badge class="mx-auto md:mx-0">Experience</Badge>
			</div>
			<div class="experience-header mb-10 grid">
				<Title class="text-center md:text-left">
					Check <Strong>Experience</Strong> and Work!
				</Title>
				<Text class="py-10 text-center md:text-left">
					Embark on a journey through my professional evolution, where every
					project tells a story of growth, expertise, and passion.
				</Text>
			</div>
			<div class="experience-body grid gap-10">
				<div class="self-start">
					<SubTitle className="text-center md:text-left">
						Work <Strong>Experience</Strong>
					</SubTitle>
					<ul class="experience-list px-8 md:px-0">
						{
							EXPERIENCE_WORK_LIST.map(({ info, period, company }) => (
								<li class="experience-list_item text-center md:text-left">
									{info}
									<span class="experience-list_item_age py-6 md:py-9">
										{period}
										<a
											class="experience-list_item_link"
											target="_blank"
											href="/"
										>
											{company}
										</a>
									</span>
								</li>
							))
						}
					</ul>
				</div>
				<div class="self-start">
					<SubTitle className="text-center md:text-left">Education</SubTitle>
					<ul class="experience-list px-8 md:px-0">
						{
							EXPERIENCE_EDUCATION_LIST.map(({ info, period, company }) => (
								<li class="experience-list_item text-center md:text-left">
									{info}
									<span class="experience-list_item_age py-6 md:py-9">
										{period}
										<a
											class="experience-list_item_link"
											target="_blank"
											href="/"
										>
											{company}
										</a>
									</span>
								</li>
							))
						}
					</ul>
				</div>
				<figure class="mx-auto xl:w-[30rem]">
					<Image
						class="mx-auto size-full"
						src={ExperienceImage}
						alt="Experience Image"
					/>
				</figure>
			</div>
			<BlurCircle
				position="-top-[5%] right-[80%] md:-top-[30%] md:-left-[10%] z-0"
				blur="blur-[90px]"
				size="size-[110px] md:size-[125px]"
			>
				<Circle
					size="size-[14px]"
					position="top-3/4 left-1/4 md:left-[60%] md:top-[60%]"
				/>
			</BlurCircle>
			<BlurCircle
				position="top-[45%] right-[5%] md:top-[20%] md:-right-[10%]"
				blur="blur-[100px]"
				size="size-0 md:size-[125px]"
			>
				<Circle
					size="size-[12px] md:size-[24px]"
					position="top-3/4 left-1/4 md:left-1/3 md:top-0"
				/>
			</BlurCircle>
		</div>
	</Container>
</section>

<style lang="scss">
	@import './scss/Experience.scss';
</style>
