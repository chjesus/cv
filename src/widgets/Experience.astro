---
import { Image } from 'astro:assets'
import HeaderImage from '@shared/assets/amico.svg'

import Badge from '@shared/ui/Badge.astro'
import Title from '@shared/ui/Title.astro'
import SubTitle from '@shared/ui/SubTitle.astro'
import Strong from '@shared/ui/Strong.astro'
import Text from '@shared/ui/Text/Text.astro'
---

<section class="experience relative py-24 md:py-48">
	<Badge sFont="text-[18px]" padding="px-16 py-3 mb-[10px]"> Experience </Badge>
	<div
		class="experience_header grid grid-cols-1 gap-y-[10px] md:grid-cols-[370px_1fr] md:gap-x-[16px] lg:grid-cols-[360px_1fr] lg:gap-x-[128px] xl:grid-cols-[470px_1fr] xl:gap-x-[180px]"
	>
		<Title>
			Check <Strong>Experience</Strong> and Work!
		</Title>
		<p class="experience_header-description text-[14px] lg:text-[20px]">
			Embark on a journey through my professional evolution, where every project
			tells a story of growth, expertise, and passion.
		</p>
	</div>
	<div
		class="grid grid-cols-1 items-center md:grid-cols-3 md:gap-[16px] xl:gap-[28px]"
	>
		<div>
			<SubTitle className="text-center md:text-left">
				Work <Strong>Experience</Strong>
			</SubTitle>
			<ul class="experiencie_lista">
				<li class="experiencie_lista-item text-center md:text-left">
					Lorem ipsum dolor sit amet, consectetur adipiscing elit.
					<span class="experiencie_lista-item_age py-[10px] md:py-[18px]">
						2020 - 2021
						<a class="experiencie_lista-item_link" target="_blank" href="/">
							Lorem, ipsum.
						</a>
					</span>
				</li>
				<li class="experiencie_lista-item text-center md:text-left">
					Lorem ipsum dolor sit amet, consectetur adipiscing elit.
					<span class="experiencie_lista-item_age py-[10px] md:py-[18px]">
						2020 - 2021
						<a class="experiencie_lista-item_link" target="_blank" href="/">
							Lorem, ipsum.
						</a>
					</span>
				</li>
				<li class="experiencie_lista-item text-center md:text-left">
					Lorem ipsum dolor sit amet, consectetur adipiscing elit.
					<span class="experiencie_lista-item_age py-[10px] md:py-[18px]">
						2020 - 2021
						<a class="experiencie_lista-item_link" target="_blank" href="/">
							Lorem, ipsum.
						</a>
					</span>
				</li>
			</ul>
		</div>
		<div>
			<SubTitle className="text-center md:text-left">Education</SubTitle>
			<ul class="experiencie_lista">
				<li class="experiencie_lista-item text-center md:text-left">
					Lorem ipsum dolor sit amet, consectetur adipiscing elit.
					<span class="experiencie_lista-item_age py-[10px] md:py-[18px]">
						2020 - 2021
						<a class="experiencie_lista-item_link" target="_blank" href="/">
							Lorem, ipsum.
						</a>
					</span>
				</li>
				<li class="experiencie_lista-item text-center md:text-left">
					Lorem ipsum dolor sit amet, consectetur adipiscing elit.
					<span class="experiencie_lista-item_age py-[10px] md:py-[18px]">
						2020 - 2021
						<a class="experiencie_lista-item_link" target="_blank" href="/">
							Lorem, ipsum.
						</a>
					</span>
				</li>
				<li class="experiencie_lista-item text-center md:text-left">
					Lorem ipsum dolor sit amet, consectetur adipiscing elit.
					<span class="experiencie_lista-item_age py-[10px] md:py-[18px]">
						2020 - 2021
						<a class="experiencie_lista-item_link" target="_blank" href="/">
							Lorem, ipsum.
						</a>
					</span>
				</li>
			</ul>
		</div>
		<div>
			<figure class="mx-auto xl:size-[300px]">
				<Image src={HeaderImage} alt="Experience Image" />
			</figure>
		</div>
	</div>
</section>

<style lang="scss">
	.experience_header {
		text-align: center;
		align-items: center;
		margin-bottom: 25px;

		@media (min-width: 768px) {
			text-align: left;
		}
		&-description {
			color: var(--text);
			font-size: 2rem;
		}
	}

	.experiencie_lista {
		font-size: 1.8rem;
		color: var(--text);
		font-weight: 400;
		&-item {
			margin-top: 16px;
			font-size: inherit;
			font-family: 'Roboto';
			font-weight: inherit;
			position: relative;

			&::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 50%;
				transform: translateX(-50%);
				width: 90px;
				height: 1px;
				background-color: white;
				@media (min-width: 768px) {
					left: 0;
					height: 2px;
					transform: initial;
				}
			}
			&:last-child {
				&::after {
					width: initial;
					height: initial;
				}
			}
			&_age {
				font-size: 1.5rem;
				font-family: 'Cardo';
				font-weight: inherit;
				display: block;
			}
			&_link {
				font-size: 1.6rem;
				font-family: 'Cardo';
				font-weight: inherit;
				transition: all 0.3s;
				&:hover {
					text-decoration: underline;
				}
			}
		}
	}
</style>
