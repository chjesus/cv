---
import { Image } from 'astro:assets'
import ExperienceImage from '@shared/assets/Group.svg'

import {
	EXPERIENCE_WORK_LIST,
	EXPERIENCE_EDUCATION_LIST,
} from '@shared/constants'

import Badge from '@shared/ui/Badge.astro'
import BlurCircle from '@shared/ui/BlurCircle.astro'
import Circle from '@shared/ui/Circle.astro'
import Title from '@shared/ui/Title.astro'
import SubTitle from '@shared/ui/SubTitle.astro'
import Text from '@shared/ui/Text.astro'
import Strong from '@shared/ui/Strong.astro'
import Container from '@app/layout/ui/Container.astro'
---

<section class="experience py-24 md:py-48">
	<Container>
		<div class="relative">
			<div class="text-center md:text-left">
				<Badge class="mx-auto md:mx-0">Experience</Badge>
			</div>
			<div class="experience-header grid grid-cols-1">
				<Title class="md:text-left">
					Check <Strong>Experience</Strong> and Work!
				</Title>
				<Text class="py-10 md:text-left">
					Embark on a journey through my professional evolution, where every
					project tells a story of growth, expertise, and passion.
				</Text>
			</div>
			<div class="experience-body grid grid-cols-1">
				<div class="self-start">
					<SubTitle className="text-center md:text-left">
						Work <Strong>Experience</Strong>
					</SubTitle>
					<ul class="experience-list px-8 md:px-0">
						{
							EXPERIENCE_WORK_LIST.map(({ info, period, company }) => (
								<li class="experience-list_item text-center md:text-left">
									{info}
									<span class="experience-list_item_age py-[10px] md:py-[18px]">
										{period}
										<a
											class="experience-list_item_link"
											target="_blank"
											href="/"
										>
											{company}
										</a>
									</span>
								</li>
							))
						}
					</ul>
				</div>
				<div class="self-start">
					<SubTitle className="text-center md:text-left">Education</SubTitle>
					<ul class="experience-list px-8 md:px-0">
						{
							EXPERIENCE_EDUCATION_LIST.map(({ info, period, company }) => (
								<li class="experience-list_item text-center md:text-left">
									{info}
									<span class="experience-list_item_age py-6 md:py-8">
										{period}
										<a
											class="experience-list_item_link"
											target="_blank"
											href="/"
										>
											{company}
										</a>
									</span>
								</li>
							))
						}
					</ul>
				</div>
				<figure class="mx-auto xl:w-[30rem]">
					<Image
						class="mx-auto size-full"
						src={ExperienceImage}
						alt="Experience Image"
					/>
				</figure>
			</div>
			<BlurCircle
				position="-top-[5%] right-[80%] md:-top-[30%] md:-left-[10%] z-0"
				blur="blur-[90px]"
				size="size-[110px] md:size-[125px]"
			>
				<Circle
					size="size-[14px]"
					position="top-3/4 left-1/4 md:left-[60%] md:top-[60%]"
				/>
			</BlurCircle>
			<BlurCircle
				position="top-[45%] right-[5%] md:top-[20%] md:-right-[10%]"
				blur="blur-[100px]"
				size="size-0 md:size-[125px]"
			>
				<Circle
					size="size-[12px] md:size-[24px]"
					position="top-3/4 left-1/4 md:left-1/3 md:top-0"
				/>
			</BlurCircle>
		</div>
	</Container>
</section>

<style lang="scss">
	.experience {
		&-header {
			text-align: center;
			align-items: center;
			margin-bottom: 25px;
			row-gap: 10px;

			@media (min-width: 768px) {
				row-gap: initial;
				column-gap: 16px;
				grid-template-columns: 360px 1fr;
			}

			@media (min-width: 1024px) {
				row-gap: initial;
				column-gap: 130px;
				grid-template-columns: 360px 1fr;
			}

			@media (min-width: 1280px) {
				row-gap: initial;
				column-gap: 190px;
				grid-template-columns: 460px 1fr;
			}
		}

		&-body {
			row-gap: 40px;
			align-items: center;

			@media (min-width: 768px) {
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 16px;
			}

			@media (min-width: 1280px) {
				gap: 28px;
			}
		}

		&-list {
			font-size: 1.8rem;
			color: var(--text);
			font-weight: 400;

			&_item {
				margin-top: 16px;
				font-size: inherit;
				font-family: 'Roboto';
				font-weight: inherit;
				position: relative;

				&::after {
					content: '';
					position: absolute;
					bottom: 0;
					left: 50%;
					transform: translateX(-50%);
					width: 90px;
					height: 1px;
					background-color: white;
					@media (min-width: 768px) {
						left: 0;
						height: 2px;
						transform: initial;
					}
				}
				&:last-child {
					&::after {
						width: initial;
						height: initial;
					}
				}
				&_age {
					font-size: 1.5rem;
					font-family: 'Cardo';
					font-weight: inherit;
					display: block;
				}
				&_link {
					font-size: 1.6rem;
					font-family: 'Cardo';
					font-weight: inherit;
					transition: all 0.3s;
					&:hover {
						text-decoration: underline;
					}
				}
			}
		}
	}
</style>
