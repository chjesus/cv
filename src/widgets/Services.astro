---
import { Icon } from 'astro-icon/components'

import Container from '@app/layout/ui/Container.astro'

const services = [
  {
    icon: 'heroicons:window-20-solid',
    title: 'Desarrollo Frontend',
    description:
      'Construyendo interfaces modernas, responsivas y escalables con foco en rendimiento y experiencia de usuario.',
    items: ['ReactJS', 'HTML/CSS', 'Arquitectura frontend'],
  },
  {
    icon: 'heroicons:device-phone-mobile-20-solid',
    title: 'Aplicaciones Móviles',
    description:
      'Construyendo aplicaciones móviles multiplataforma fluidas e intuitivas para iOS y Android.',
    items: ['React Native', 'Flutter', 'Publicación en App Store'],
    isHidden: true,
  },
  {
    icon: 'heroicons:code-bracket-20-solid',
    title: 'Arquitectura de Interfaces',
    description:
      'Diseñando estructuras frontend mantenibles para aplicaciones web modernas, escalables y fáciles de evolucionar.',
    items: [
      'Feature-Sliced Design',
      'Componentes reutilizables',
      'Buenas prácticas',
    ],
  },
]
---

<section class="premium-section services" id="services">
  <Container class="!max-w-[1280px]">
    <div
      class="services-header mb-[6.4rem] flex items-end justify-between gap-[2.4rem]"
    >
      <div>
        <h2 class="premium-title">
          Competencias <span class="text-luminous">Clave</span>
        </h2>
        <p class="premium-copy">
          Creando soluciones integrales con precisión técnica y sensibilidad de
          diseño.
        </p>
      </div>
    </div>

    <div
      class="services-grid grid grid-cols-3 gap-[2.4rem] max-[900px]:grid-cols-1"
    >
      {
        services.map((service) => (
          <article
            class:list={[
              'service-card glass-card mouse-track-container flex min-h-[38rem] flex-col items-start p-[3.2rem]',
              service.isHidden && 'hidden',
            ]}
          >
            <div class="glow-overlay" />
            <div class="service-card__bar" />
            <span class="service-card__icon relative z-[2] grid h-[5.6rem] w-[5.6rem] place-items-center">
              <Icon name={service.icon} />
            </span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <ul class="relative z-[2] grid gap-[1.2rem]">
              {service.items.map((item) => (
                <li class="flex items-center gap-[1.2rem]">
                  <Icon name="heroicons:chevron-right-20-solid" /> {item}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style lang="scss">
  @use './scss/Services.scss';
</style>

<script>
  const serviceCards = document.querySelectorAll('.service-card')

  serviceCards.forEach((card) => {
    if (!(card instanceof HTMLElement)) return

    card.addEventListener('mousemove', (event) => {
      const rect = card.getBoundingClientRect()

      card.style.setProperty('--mouse-x', `${event.clientX - rect.left}px`)
      card.style.setProperty('--mouse-y', `${event.clientY - rect.top}px`)
    })
  })
</script>
