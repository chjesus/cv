---
import { Icon } from 'astro-icon/components'

import Container from '@app/layout/ui/Container.astro'

const services = [
	{
		icon: 'heroicons:window-20-solid',
		title: 'Web Design',
		description:
			'Crafting stunning, responsive, and user-centric web interfaces that elevate your brand.',
		items: ['UI/UX Design', 'Prototyping', 'Design Systems'],
	},
	{
		icon: 'heroicons:device-phone-mobile-20-solid',
		title: 'Mobile App',
		description:
			'Building seamless and intuitive cross-platform mobile applications for iOS and Android.',
		items: ['React Native', 'Flutter', 'App Store Deployment'],
	},
	{
		icon: 'heroicons:code-bracket-20-solid',
		title: 'Software Development',
		description:
			'Engineering robust, custom software solutions tailored to your business requirements.',
		items: ['Full-Stack Solutions', 'API Integration', 'Cloud Architecture'],
	},
]
---

<section class="premium-section services" id="services">
	<Container class="!max-w-[1280px]">
		<div
			class="services-header mb-[6.4rem] flex items-end justify-between gap-[2.4rem]"
		>
			<div>
				<h2 class="premium-title">
					Core <span class="text-luminous">Competencies</span>
				</h2>
				<p class="premium-copy">
					Delivering end-to-end solutions with technical precision and design
					sensibility.
				</p>
			</div>
		</div>

		<div
			class="services-grid grid grid-cols-3 gap-[2.4rem] max-[900px]:grid-cols-1"
		>
			{
				services.map((service) => (
					<article class="service-card glass-card mouse-track-container flex min-h-[38rem] flex-col items-start p-[3.2rem]">
						<div class="glow-overlay" />
						<div class="service-card__bar" />
						<span class="service-card__icon relative z-[2] grid h-[5.6rem] w-[5.6rem] place-items-center">
							<Icon name={service.icon} />
						</span>
						<h3>{service.title}</h3>
						<p>{service.description}</p>
						<ul class="relative z-[2] grid gap-[1.2rem]">
							{service.items.map((item) => (
								<li class="flex items-center gap-[1.2rem]">
									<Icon name="heroicons:chevron-right-20-solid" /> {item}
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</Container>
</section>

<style lang="scss">
	@use './scss/Services.scss';
</style>

<script>
	const serviceCards = document.querySelectorAll('.service-card')

	serviceCards.forEach((card) => {
		if (!(card instanceof HTMLElement)) return

		card.addEventListener('mousemove', (event) => {
			const rect = card.getBoundingClientRect()

			card.style.setProperty('--mouse-x', `${event.clientX - rect.left}px`)
			card.style.setProperty('--mouse-y', `${event.clientY - rect.top}px`)
		})
	})
</script>
