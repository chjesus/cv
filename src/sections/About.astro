---
import { Image } from 'astro:assets'

import PhotoProfile from '../assets/foto.png'
import Badge from '../components/Badge.astro'
import HtmlLogo from '../assets/Logos/HTML5.png'
import CSSLogo from '../assets/Logos/CSS3.png'
import ReactJsLogo from '../assets/Logos/React.png'
import NextJsLogo from '../assets/Logos/Nextjs.png'
import JSLogo from '../assets/Logos/JavaScript.png'
import AstroLogo from '../assets/Logos/Astro.png'
---

<section class="px-5 md:px-16 md:py-16 xl:py-28">
	<div class="mx-auto max-w-screen-xl">
		<div class="grid grid-cols-2 items-center md:gap-5">
			<div class="mx-auto">
				<figure>
					<Image src={PhotoProfile} alt="Foto de perfil" />
				</figure>
			</div>
			<div class="">
				<Badge title="About me" className="--subtitle px-11 py-2" />
				<h1 class="about-title lg:mb-6 xl:mb-7 xl:mt-2.5">
					<span>Jesus</span> Chacon
				</h1>
				<p class="about-description mb-3">
					Lorem Ipsum is simply dummy text of the printing and typesetting
					industry. Lorem Ipsum has been the industry's standard dummy text ever
					since the 1500s.
				</p>
				<p class="about-description mb-3">
					It has survived not only five centuries, but also the leap into
					electronic typesetting, remaining essentially unchanged.
				</p>
				<div>
					<h2 class="about-subtitle md:my-3 lg:my-4 xl:my-6">Skills</h2>
					<ul class="about-skills">
						<li class="about-skills_item">
							<Image class="w-12" src={HtmlLogo} alt="HTML Logo" />
						</li>
						<li class="about-skills_item">
							<Image class="w-12" src={CSSLogo} alt="CSS Logo" />
						</li>
						<li class="about-skills_item">
							<Image class="w-12" src={JSLogo} alt="JavaScript Logo" />
						</li>
						<li class="about-skills_item">
							<Image class="w-12" src={ReactJsLogo} alt="ReactJs Logo" />
						</li>
						<li class="about-skills_item">
							<Image class="w-12" src={NextJsLogo} alt="NextJs Logo" />
						</li>
						<li class="about-skills_item">
							<Image class="w-12" src={AstroLogo} alt="Astro Logo" />
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	figure {
		position: relative;
		/* overflow: hidden; */
		max-width: 450px;
	}
	figure::after {
		content: '';
		width: 100%;
		position: absolute;
		bottom: 0;
		left: 0;
		height: 50%;
		z-index: 0;
		background-color: var(--primary);
		border-radius: 20px;
	}
	@media (min-width: 768px) {
		figure {
			max-width: 320px;
		}

		figure::after {
			height: 50%;
		}
	}

	@media (min-width: 1280px) {
		figure {
			max-width: 450px;
		}
	}

	figure img {
		z-index: 1;
		position: relative;
	}
	.about-title {
		font-weight: 900;
		font-family: 'Roboto';
		font-size: 24px;
		color: var(--text);
		text-transform: uppercase;
	}
	@media (min-width: 768px) {
		.about-title {
			font-size: 32px;
		}
	}

	@media (min-width: 998px) {
		.about-title {
		}
	}

	@media (min-width: 1280px) {
		.about-title {
			font-size: 46px;
			line-height: 54px;
		}
	}
	h1 span {
		color: var(--primary);
	}

	h2 {
		color: var(--text);
	}
	.about-description {
		font-family: 'Roboto';
		font-size: 14px;
		font-weight: 400;
		color: var(--text);
		width: fit-content;
	}

	@media (min-width: 768px) {
		.about-description {
		}
	}

	@media (min-width: 998px) {
		.about-description {
		}
	}

	@media (min-width: 1280px) {
		.about-description {
			font-size: 20px;
		}
	}
	.about-subtitle {
		font-family: 'Roboto';
		font-size: 28px;
		padding-bottom: 10px;
		font-weight: 500;
		position: relative;
	}

	.about-subtitle::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 90px;
		height: 2px;
		background-color: white;
	}

	@media (min-width: 768px) {
		.about-subtitle {
			font-size: 18px;
		}
	}

	@media (min-width: 1280px) {
		.about-subtitle {
			font-size: 28px;
		}
	}
	.about-skills {
		display: flex;
		gap: 20px;
	}

	.about-skills_item {
		padding: 5px;
		border-radius: 5px;
		cursor: pointer;
		background-color: rgb(255, 255, 255, 0.25);
	}
</style>
