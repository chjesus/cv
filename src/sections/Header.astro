---
import { Image } from 'astro:assets'
import HeaderImage from '../assets/amico.svg'

import Button from '../components/Button.astro'
import Badge from '../components/Badge.astro'
import Circle from '../components/CircleBlur.astro'
---

<header class="relative px-5 lg:px-16">
	<Circle number="1" blurSize="h-48 w-48" circleSize="h-4 w-4" />
	<Circle number="2" blurSize="h-0 w-0 md:h-20 md:w-20" circleSize="h-2 w-2" />
	<div class="relative z-10 mx-auto max-w-screen-xl">
		<div class="grid grid-cols-1 py-8 md:grid-cols-2 md:py-12 lg:py-24">
			<div class="flex flex-col items-center justify-center md:items-start">
				<div class="mx-auto md:ml-0">
					<Badge title="Hello there" className="px-2.5 py-1.5" />
				</div>
				<h1 class="header-title pt-3 text-center md:text-left">
					<strong> Experience the Mastery </strong>
					Explore my Website Creations.
				</h1>
				<p class="header-description py-6 text-center md:text-left">
					Welcome to my portfolio of captivating digital experiences. Explore my
					work and let's create something extraordinary together.
				</p>
				<div class="grid auto-cols-max grid-flow-col gap-2">
					<Button text="Hire me" link={true} icon={false} />
					<Button text="View Portfolio" link={false} icon={true} />
				</div>
			</div>
			<div
				class="mt-12 flex items-center justify-center md:mt-0 md:justify-end"
			>
				<figure>
					<Image src={HeaderImage} alt="Amico" />
				</figure>
			</div>
		</div>
	</div>
</header>

<style>
	.header-title {
		font-size: 28px;
		font-family: 'Roboto';
		line-height: 33px;
		color: var(--text);
	}

	@media (min-width: 768px) {
		.header-title {
			font-size: 36px;
			line-height: 42px;
		}
	}
	@media (min-width: 998px) {
		.header-title {
			font-size: 44px;
			line-height: 52px;
		}
	}

	@media (min-width: 1280px) {
		.header-title {
			font-size: 62px;
			line-height: 73px;
		}
	}

	.header-title strong {
		color: var(--primary);
	}

	.header-description {
		font-weight: normal;
		font-family: 'Cardo';
		font-size: 12px;
		color: var(--text);
	}
	@media (min-width: 768px) {
		.header-description {
			font-size: 14.22px;
			text-align: left;
		}
	}

	@media (min-width: 1280px) {
		.header-description {
			font-size: 20px;
		}
	}

	@media (min-width: 768px) {
		figure {
			max-width: 300px;
		}
	}

	@media (min-width: 998px) {
		figure {
			max-width: 330px;
		}
	}

	@media (min-width: 1280px) {
		figure {
			max-width: 470px;
		}
	}
</style>
