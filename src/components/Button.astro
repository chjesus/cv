---
// import {Icon } from 'astro-icon/components'
import ArrowRight from './icons/ArrowRight.astro'
interface Props {
	text: string
	link: boolean
	icon: boolean
}

const { text, link, icon } = Astro.props
---

<button
	class=`${ link ? 'px-7 md:px-10' : 'bg-transparent px-4' } py-1.5 md:py-2.5`
>
	{text}
	{icon ? <ArrowRight class="size-3.5 fill-white" /> : ''}
</button>

<style>
	button {
		display: flex;
		align-items: center;
		gap: 4px;
		width: fit-content;
		color: var(--text);
		font-size: 12px;
		font-family: 'Roboto';
		border-radius: 999px;
	}

	@media (min-width: 768px) {
		button {
			font-size: 14px;
		}
	}

	button:not(.bg-transparent) {
		background-color: var(--primary);
	}
</style>
