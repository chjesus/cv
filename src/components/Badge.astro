---
interface Props {
	title: string
	className?: string
}

const { title, className } = Astro.props
---

<span class=`rounded-lg bg-white ${className}`>
	{title}
</span>

<style>
	span {
		font-size: 15px;
		text-transform: capitalize;
		font-family: 'Manrope';
		color: var(--text-dark);
		display: inline-block;
	}

	@media (min-width: 768px) {
		span {
			font-size: 10px;
		}
		span.--subtitle {
			font-size: 12px;
		}
	}
	@media (min-width: 1280px) {
		span {
			font-size: 15px;
		}

		span.--subtitle {
			font-size: 18px;
		}
	}
</style>
