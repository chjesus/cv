---
import styles from './Nav.module.css'
import { Image } from 'astro:assets'
import Logo from '../../assets/logo.png'
import Bars from '../icons/Bars.astro'
---

<nav class="sticky z-20 px-5 lg:px-16">
	<div class="mx-auto max-w-screen-xl rounded-full bg-white px-5 py-2 lg:px-2">
		<div class="grid auto-cols-max grid-flow-col justify-between gap-x-5">
			<div class="hidden auto-cols-max grid-flow-col gap-x-2 lg:grid">
				<div class="nav-item rounded-full px-3 py-2.5 lg:w-24 xl:w-36">
					Home
				</div>
				<div class="nav-item rounded-full px-3 py-2.5 lg:w-24 xl:w-36">
					About
				</div>
				<div class="nav-item rounded-full px-3 py-2.5 lg:w-24 xl:w-36">
					Services
				</div>
			</div>
			<div class="m-auto text-center">
				<figure class="cursor-pointer">
					<Image
						class="h-6 w-auto object-cover lg:h-11"
						src={Logo}
						alt="Logo Jesus DEV"
					/>
				</figure>
			</div>
			<div class="cursor-pointer lg:hidden">
				<Bars />
			</div>
			<div class="hidden auto-cols-max grid-flow-col gap-x-2 lg:grid">
				<div class="nav-item rounded-full px-3 py-2.5 lg:w-24 xl:w-36">
					Portfolio
				</div>
				<div class="nav-item rounded-full px-3 py-2.5 lg:w-24 xl:w-36">
					My projects
				</div>
				<div class="nav-item rounded-full px-3 py-2.5 lg:w-24 xl:w-36">
					Contact us
				</div>
			</div>
		</div>
	</div>
</nav>

<style>
	nav {
		top: 12px;
	}

	.nav-item {
		font-weight: 700;
		cursor: pointer;
		transition: all 0.3s;
		text-align: center;
		font-weight: 600;
		font-family: 'Source Sans 3';
		color: var(--text-dark);
	}

	.nav-item:hover {
		background-color: var(--secondary);
	}

	@media (min-width: 998px) {
		.nav-item {
			font-size: 14px;
			line-height: 24px;
		}
	}

	@media (min-width: 1280px) {
		.nav-item {
			font-size: 20px;
		}
	}
</style>
